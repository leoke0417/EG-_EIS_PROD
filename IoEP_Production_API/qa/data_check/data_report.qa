###
### Send result to Google chat room.
###	1. Get running test case from quick-scan_eis.qas.
###	2. Get testing result from {workspace}\log\{test case}\{test case}.xml
###	3. Merge all result and make them human readable.
### 4. Send result.
###

ini										api_IoEP.ini
start

###	Step 1.
$qa_list$=get						qas_result					qa_list				#path#=qa\data_check\data.qas,#report_file#=data_report

###	Step 2.
$xml_list$=get						qas_result					xml_list			#list#=$qa_list$,#path_prefix#=data\

###	Step 3.
$overall_result$=get				qas_result					overall_result		#qa_test_result#=$xml_list$,#environment#=$environment$,#project_name#=data_check,#unit#=data,#only_shows_false#=True

$final_result$=get					qas_result					final_result		#text#=$xml_list$
###	Step 4.
send								Fb3						googlemessage		#message#=$overall_result$

send								Fb4							googlemessage		#message#=$final_result$
#end
$devices_deviceUuid_dashboard_status_code$=get			egplus_api				status_code									#response#=$devices_deviceUuid_dashboard_response$
verify													api_verification		status_code									#api_response#=$devices_deviceUuid_dashboard_status_code$,#expected_status_code#=200
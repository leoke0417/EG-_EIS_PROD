$request_url$=get				dms_api				ums_login_url				#environment#=url
$request_header$=get			dms_api				ums_login_header
$request_body$=get				dms_api				ums_login_body				#email#=email,#password#=password,#clientId#=clientId


$response$=get					dms_api				post						#url#=$request_url$,#header#=$request_header$,#body#=$request_body$
$status_code$=get				dms_api				status_code					#response#=$response$
verify							api_verification	status_code					#api_response#=$status_code$,#expected_status_code#=200

$response_body$=get				dms_api				response_body				#response#=$response$
$accessToken$=get				dms_api				dict_dict_value				#response_body#=$response_body$,#first_key#=data,#second_key#=accessToken


set								dms_api				config						#section#=params,#scope#=accessToken,#value#=$accessToken$









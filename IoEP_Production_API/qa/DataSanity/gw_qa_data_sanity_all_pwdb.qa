##check process of system 
##including file path and process id

ini			fwapi_data_sanity_devices.ini

start

$count_pdb_normalUsage$=get				fwapi_data_sanity		ioeapi_device_data2		#env#=qa,#strDeviceDataPath#=$api_data_query$,#dev_uuid#=$qa_pwdb_uuid$,#data_scope#=$qa_PWDBoard_normalUsage$,#time_period#=86400
$count_pdb_reverseUsage$=get			fwapi_data_sanity		ioeapi_device_data2		#env#=qa,#strDeviceDataPath#=$api_data_query$,#dev_uuid#=$qa_pwdb_uuid$,#data_scope#=$qa_PWDBoard_reverseUsage$,#time_period#=86400

$fw_version$=get						File					shellcmd				#command#=adb -s $atto_name$ shell getprop ro.build.version.release 

$result$=get							fwapi_data_sanity		pdb_result		#fw_version#=$fw_version$,#env#=qa,#count_pdb_normalUsage#=$count_pdb_normalUsage$,#count_pdb_reverseUsage#=$count_pdb_reverseUsage$
send									Fb						automan_production		#message#=$result$

end

##check process of system 
##including file path and process id

ini									fwapi_data_sanity_devices.ini
start

###	Step 1.
$qa_list$=get						eg_plus_result_upload				qa_list				#path#=qa\qas\prod_data_check.qas

###	Step 2.
$xml_list$=get						eg_plus_result_upload				xml_list			#list#=$qa_list$,#path_prefix#=prod_data_check\

###	Step 3.
$eg_plus_fw_version$=get 			eg_plus_result_upload 			CMD_response		#command#=adb -s $prod_cube_name$ shell "getprop | grep ro.build.version.release"

###	Step 4.
$overall_result$=get				eg_plus_result_upload				overall_result		#text#=$xml_list$,#fw_version#=$eg_plus_fw_version$,#testing_environment#=production

###	Step 5.
send								Fb							automan_production		#message#=$overall_result$

end


end

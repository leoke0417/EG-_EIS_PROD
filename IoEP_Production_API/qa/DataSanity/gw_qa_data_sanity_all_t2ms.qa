##check process of system 
##including file path and process id

ini			fwapi_data_sanity_devices.ini

start

$count_t2ms_meterUnit$=get				fwapi_data_sanity		ioeapi_device_data2		#env#=qa,#strDeviceDataPath#=$api_data_query$,#dev_uuid#=$qa_t2ms_uuid$,#data_scope#=$qa_SmaMe-TypeM_meterUnit$,#time_period#=86400
$count_t2ms_normalUsage$=get			fwapi_data_sanity		ioeapi_device_data2		#env#=qa,#strDeviceDataPath#=$api_data_query$,#dev_uuid#=$qa_t2ms_uuid$,#data_scope#=$qa_SmaMe-TypeM_normalUsage$,#time_period#=86400
$count_t2ms_reverseUsage$=get			fwapi_data_sanity		ioeapi_device_data2		#env#=qa,#strDeviceDataPath#=$api_data_query$,#dev_uuid#=$qa_t2ms_uuid$,#data_scope#=$qa_SmaMe-TypeM_reverseUsage$,#time_period#=86400
$count_t2ms_currentReverseUsage$=get	fwapi_data_sanity		ioeapi_device_data2		#env#=qa,#strDeviceDataPath#=$api_data_query$,#dev_uuid#=$qa_t2ms_uuid$,#data_scope#=$qa_SmaMe-TypeM_currentReverseUsage$,#time_period#=86400
$count_t2ms_currentNormalUsage$=get		fwapi_data_sanity		ioeapi_device_data2		#env#=qa,#strDeviceDataPath#=$api_data_query$,#dev_uuid#=$qa_t2ms_uuid$,#data_scope#=$qa_SmaMe-TypeM_currentNormalUsage$,#time_period#=86400



$fw_version$=get						File					shellcmd				#command#=adb -s $atto_name$ shell getprop ro.build.version.release 

$result$=get							fwapi_data_sanity		t2ms_result		#fw_version#=$fw_version$,#env#=qa,#count_t2ms_meterUnit#=$count_t2ms_meterUnit$,#count_t2ms_normalUsage#=$count_t2ms_normalUsage$,#count_t2ms_reverseUsage#=$count_t2ms_reverseUsage$,#count_t2ms_currentReverseUsage#=$count_t2ms_currentReverseUsage$,#count_t2ms_currentNormalUsage#=$count_t2ms_currentNormalUsage$

send									Fb						automan_production		#message#=$result$

end

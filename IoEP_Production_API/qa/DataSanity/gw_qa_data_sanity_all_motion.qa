##check process of system 
##including file path and process id

ini			fwapi_data_sanity_devices.ini

start

$count_battery$=get		fwapi_data_sanity		ioeapi_device_data2		#env#=qa,#strDeviceDataPath#=$api_data_query$,#dev_uuid#=$qa_motion_uuid$,#data_scope#=$qa_Pixi-G_battery$,#time_period#=86400
$fw_version$=get		File					shellcmd				#command#=adb -s $atto_name$ shell getprop ro.build.version.release 

$result$=get			fwapi_data_sanity		pixig_result			#fw_version#=$fw_version$,#env#=qa,#count_battery#=$count_battery$
send					Fb						automan_production		#message#=$result$




end

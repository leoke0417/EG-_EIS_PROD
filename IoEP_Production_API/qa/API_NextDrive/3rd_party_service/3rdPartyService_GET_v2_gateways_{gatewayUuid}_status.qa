ini							api_3rd_party_service.ini
start

$cmd$=get					postman					command				#collection#=c_QA_3rdPartyService_GET_v2_gateways_{gatewayUuid}_status.json,#environment#=e_3rd_party_service.json,#iterations#=1

exec						postman					command				#command#=$cmd$

$result_file$=get			postman					result		

$list_data$=get				postman					read_csv			#filename#=$result_file$

$target_data$=get			postman					find_result			#file#=$list_data$,#testcase#=GET_v2_gateways_{gatewayUuid}_status

$result$=get				postman					api_result			#api_result#=$target_data$

verify						postman					status_code			#api_result#=$result$,#expected_result#=200

$response_body$=get			api_verification		api_response		#api_result#=$result$

$expected_body$=get			api_verification		expected_result		#environment#=$test_environment$,#expected_result#=3rd_party_service\GET_v2_gateways_{gatewayUuid}_status.json

verify						api_verification		dict_keys			#expected_result#=$expected_body$,#actual_result#=$response_body$

$name$=get					file_operate			dict_value			#key#=name,#response_body#=$response_body$

$model$=get					file_operate			dict_value			#key#=model,#response_body#=$response_body$

$fwVersion$=get				file_operate			dict_value			#key#=fwVersion,#response_body#=$response_body$

$onlineStatus$=get			file_operate			dict_value			#key#=onlineStatus,#response_body#=$response_body$

verify						api_verification		string				#actual_result#=$name$

verify						api_verification		string				#actual_result#=$model$

verify						api_verification		string				#actual_result#=$fwVersion$

verify						api_verification		string				#actual_result#=$onlineStatus$
# end
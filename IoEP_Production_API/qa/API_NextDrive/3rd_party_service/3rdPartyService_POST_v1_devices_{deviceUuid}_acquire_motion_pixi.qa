ini							api_3rd_party_service.ini
start

$cmd$=get					postman					command				#collection#=c_QA_3rd_party_service_POST_v1_devices_{deviceUuid}_acquire.json,#environment#=e_3rd_party_service.ioep.json,#iterations#=1

exec						postman					command				#command#=$cmd$

$result_file$=get			postman					result		

$list_data$=get				postman					read_csv			#filename#=$result_file$

$target_data$=get			postman					find_result			#file#=$list_data$,#testcase#=POST_v1_devices_{deviceUuid}_acquire_motion_pixi

$result$=get				postman					api_result			#api_result#=$target_data$

verify						postman					status_code			#api_result#=$result$,#expected_result#=200

$response_body$=get			api_verification		api_response		#api_result#=$result$

$expected_body$=get			api_verification		expected_result		#environment#=$test_environment$,#expected_result#=3rd_party_service\POST_v1_devices_{deviceUuid}_acquire_motion_pixi.json

verify						api_verification		dict_keys			#expected_result#=$expected_body$,#actual_result#=$response_body$

$requestId$=get				file_operate			dict_value			#key#=requestId,#response_body#=$response_body$

verify						api_verification		uuid				#actual_result#=$requestId$
# end
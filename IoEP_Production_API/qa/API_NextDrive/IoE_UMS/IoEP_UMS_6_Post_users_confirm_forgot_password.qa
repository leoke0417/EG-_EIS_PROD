ini								api_ioep_ums.ini
start

### Read access code from gmail ----------------------------------------------
$verify_code$=get				read_access_code		read_from_mail
sleep							2
$get_code$=get					read_access_code		access_code_from_file
set								postman2				collection_variable			#json_name#=IOEP_UMS_usermanagement.json,#target_key#=confirmCode,#value#=$get_code$
set								postman2				delete_gmail

### Execute Confirm-forgot-password  ------------------
$cmd$=get						postman2				command						#collection#=IOEP_UMS_usermanagement.json,#folder#=Confirm-forgot-password,#iterations#=1
exec							postman					command						#command#=$cmd$

### Get result and check status ----------------------------------------------
$result_file$=get				postman					result		

$list_data$=get					postman					read_csv					#filename#=$result_file$

$target_data$=get				postman					find_result					#file#=$list_data$,#testcase#=Confirm-forgot-password

$result$=get					postman					api_result					#api_result#=$target_data$

verify							postman					status_code					#api_result#=$result$,#expected_result#=200

$response_body$=get				api_verification		api_response				#api_result#=$result$

$expected_result$=get			api_verification		expected_result				#environment#=$test_environment$,#expected_result#=IoE_UMS\6_Post_users_confirm_forgot_password.json

verify							api_verification		dict_keys					#expected_result#=$expected_result$,#actual_result#=$response_body$


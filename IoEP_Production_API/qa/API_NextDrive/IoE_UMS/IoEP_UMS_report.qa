###
### Send result to Google chat room.
###	1. Get running test case from IoE_UMS.qas.
###	2. Get testing result from {workspace}\log\{test case}\{test case}.xml
###	3. Merge all result and make them human readable.
### 4. Send result.
###

ini									api_ioep_ums.ini

start


$qa_list$=get						qas_result					qa_list				#path#=qa\API_NextDrive\IoE_UMS\IoEP_UMS.qas,#report_file#=IoE_UMS


$xml_list$=get						qas_result					xml_list			#list#=$qa_list$,#path_prefix#=IoEP_UMS\


$overall_result$=get				qas_result					overall_result		#qa_test_result#=$xml_list$,#environment#=$environment$,#project_name#=Production_IoEP-API IoE-UMS,#unit#=APIs,#only_shows_false#=True


$final_result$=get					qas_result					final_result		#text#=$xml_list$


send								Fb							googlemessage		#message#=$overall_result$


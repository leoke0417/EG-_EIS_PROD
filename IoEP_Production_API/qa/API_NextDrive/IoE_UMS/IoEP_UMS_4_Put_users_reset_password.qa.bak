ini										api_ioep_ums.ini

start

$oldpassword$=get						postman2				collection_variable			#json_name#=IOEP_UMS_usermanagement.json,#target_key#=password
$newpassword$=get						postman2				collection_variable			#json_name#=IOEP_UMS_usermanagement.json,#target_key#=proposedPassword


### Execute c_ioe_account_PUT_account_v1_users_reset_password.json file ------------------
$cmd$=get								postman2				command					#collection#=IOEP_UMS_usermanagement.json,#iterations#=1,#folder#=Reset-password
exec									postman					command						#command#=$cmd$

### Get result and check status ----------------------------------------------
$result_file$=get						postman					result		

$list_data$=get							postman					read_csv					#filename#=$result_file$

$target_data$=get						postman					find_result					#file#=$list_data$,#testcase#=Reset-password

$result$=get							postman					api_result					#api_result#=$target_data$

verify									postman					status_code					#api_result#=$result$,#expected_result#=200

$response_body$=get						api_verification		api_response				#api_result#=$result$

$expected_body$=get						api_verification		expected_result				#environment#=$test_environment$,#expected_result#=IoE_UMS\4_Put_users_reset_password.json

verify									api_verification		dict_keys					#expected_result#=$expected_body$,#actual_result#=$response_body$
		
### Write access token into file ----------------------------------------------
set										postman2				collection_variable			#json_name#=IOEP_UMS_usermanagement.json,#target_key#=password,#value#=$newpassword$
set										postman2				collection_variable			#json_name#=IOEP_UMS_usermanagement.json,#target_key#=proposedPassword,#value#=$oldpassword$

								

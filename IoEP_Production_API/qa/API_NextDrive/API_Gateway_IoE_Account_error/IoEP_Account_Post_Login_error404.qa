ini								api_ioe_account.ini
start

### Execute c_ioe_account_POST-v1-users-login.json file ------------------
$cmd$=get						postman					command						#collection#=c_ioe_account_POST-v1-users-login_error.json,#environment#=$ee$,#iterations#=1
exec							postman					command						#command#=$cmd$

### Get result and check status ----------------------------------------------
$result_file$=get				postman					result		

$list_data$=get					postman					read_csv					#filename#=$result_file$

$target_data$=get				postman					find_result					#file#=$list_data$,#testcase#=POST /account/v1/users/login

$result$=get					postman					api_result					#api_result#=$target_data$

verify							postman					status_code					#api_result#=$result$,#expected_result#=404



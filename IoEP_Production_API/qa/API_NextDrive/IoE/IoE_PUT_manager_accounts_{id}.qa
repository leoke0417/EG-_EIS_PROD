ini				api_ioe.ini
start

$cmd$=get								postman					command						#collection#=c_QA_IoE_PUT_manager_accounts_{id}.json,#environment#=e_IoE.json,#iterations#=1

exec									postman					command						#command#=$cmd$

$result_file$=get						postman					result		

$list_data$=get							postman					read_csv					#filename#=$result_file$

$target_data$=get						postman					find_result					#file#=$list_data$,#testcase#=PUT_manager_accounts_{id}

$result$=get							postman					api_result					#api_result#=$target_data$

verify									postman					status_code					#api_result#=$result$,#expected_result#=200

$response_body$=get						api_verification		api_response				#api_result#=$result$

$expected_body$=get						api_verification		expected_result				#environment#=$test_environment$,#expected_result#=IoE\PUT_manager_accounts_{id}.json

verify									api_verification		dict_keys					#expected_result#=$expected_body$,#actual_result#=$response_body$

$role$=get								file_operate			dict_value					#key#=role,#response_body#=$response_body$

$accessModules_type$=get				file_operate			dict_list_dict_value		#first_key#=accessModules,#second_key#=type,#response_body#=$response_body$

$accessModules_label$=get				file_operate			dict_list_dict_value		#first_key#=accessModules,#second_key#=label,#response_body#=$response_body$

$accessModules_activated$=get			file_operate			dict_list_dict_value		#first_key#=accessModules,#second_key#=activated,#response_body#=$response_body$

$accessModules_lastActivatedOn$=get		file_operate			dict_list_dict_value		#first_key#=accessModules,#second_key#=lastActivatedOn,#response_body#=$response_body$

$ioeSuiteActivated$=get					file_operate			dict_value					#key#=ioeSuiteActivated,#response_body#=$response_body$

$id$=get								file_operate			dict_value					#key#=id,#response_body#=$response_body$

verify									api_verification		string						#actual_result#=$role$

verify									api_verification		string						#actual_result#=$accessModules_type$

verify									api_verification		string						#actual_result#=$accessModules_label$

verify									api_verification		boolean						#actual_result#=$accessModules_activated$

verify									api_verification		time						#actual_result#=$accessModules_lastActivatedOn$

verify									api_verification		boolean						#actual_result#=$ioeSuiteActivated$

verify									api_verification		int							#actual_result#=$id$

# end
ini				api_ioe.ini
start

$cmd$=get								postman					command						#collection#=c_QA_IoE_GET_hems_dashbaord_device-location.json,#environment#=e_IoE.json,#iterations#=1

exec									postman					command						#command#=$cmd$

$result_file$=get						postman					result		

$list_data$=get							postman					read_csv					#filename#=$result_file$

$target_data$=get						postman					find_result					#file#=$list_data$,#testcase#=GET_hems_dashbaord_device-location

$result$=get							postman					api_result					#api_result#=$target_data$

verify									postman					status_code					#api_result#=$result$,#expected_result#=200

$response_body$=get						api_verification		api_response				#api_result#=$result$

$expected_body$=get						api_verification		expected_result				#environment#=$test_environment$,#expected_result#=IoE\GET_hems_dashbaord_device-location.json

verify									api_verification		dict_keys					#expected_result#=$expected_body$,#actual_result#=$response_body$



### =====
### Get data
### =====
## Get total
$response_total$=get					file_operate			dict_value					#key#=total,#response_body#=$response_body$

## Get locations > name
$response_locations_name$=get			file_operate			dict_list_dict_value		#first_key#=locations,#second_key#=name,#response_body#=$response_body$

## Get location > total
$response_locations_total$=get			file_operate			dict_list_dict_value		#first_key#=locations,#second_key#=total,#response_body#=$response_body$


### =====
### Verify
### =====
## Verify total
verify									api_verification		int							#actual_result#=$response_total$

## Verify locations > name
verify									api_verification		string						#actual_result#=$response_locations_name$

## Verify location > total
verify									api_verification		int							#actual_result#=$response_locations_total$
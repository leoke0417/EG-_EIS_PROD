ini				api_ioe.ini
start

$cmd$=get					postman					command				#collection#=c_QA_IoE_DELETE_customer-accounts_otp.json,#environment#=e_IoE.json,#iterations#=1

exec						postman					command				#command#=$cmd$

$result_file$=get			postman					result		

$list_data$=get				postman					read_csv			#filename#=$result_file$

$target_data$=get			postman					find_result			#file#=$list_data$,#testcase#=DELETE_customer-accounts_otp

$result$=get				postman					api_result			#api_result#=$target_data$

verify						postman					status_code			#api_result#=$result$,#expected_result#=200

$response_body$=get			api_verification		api_response		#api_result#=$result$

$expected_body$=get			api_verification		expected_result		#environment#=$test_environment$,#expected_result#=IoE\DELETE_customer-accounts_otp.json

# end
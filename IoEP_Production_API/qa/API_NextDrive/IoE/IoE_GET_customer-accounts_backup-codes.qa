ini				api_ioe.ini
start

$cmd$=get								postman					command						#collection#=c_QA_IoE_GET_customer-accounts_backup-codes.json,#environment#=e_IoE.json,#iterations#=1

exec									postman					command						#command#=$cmd$

$result_file$=get						postman					result		

$list_data$=get							postman					read_csv					#filename#=$result_file$

$target_data$=get						postman					find_result					#file#=$list_data$,#testcase#=GET_customer-accounts_backup-codes

$result$=get							postman					api_result					#api_result#=$target_data$

verify									postman					status_code					#api_result#=$result$,#expected_result#=200

$response_body$=get						api_verification		api_response				#api_result#=$result$

$expected_body$=get						api_verification		expected_result				#environment#=$test_environment$,#expected_result#=IoE\GET_customer-accounts_backup-codes.json

verify									api_verification		dict_keys					#expected_result#=$expected_body$,#actual_result#=$response_body$


## get codes
$backup_code_codes$=get					file_operate			dict_list_value				#key#=backupCodes,#response_body#=$response_body$

## Verify string
verify									api_verification		string						#actual_result#=$backup_code_codes$
##===== END =====

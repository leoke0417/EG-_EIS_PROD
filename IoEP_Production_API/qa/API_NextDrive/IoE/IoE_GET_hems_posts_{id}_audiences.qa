ini				api_ioe.ini
start

$cmd$=get								postman					command						#collection#=c_QA_IoE_GET_hems_posts_{id}_audiences.json,#environment#=e_IoE.json,#iterations#=1

exec									postman					command						#command#=$cmd$

$result_file$=get						postman					result		

$list_data$=get							postman					read_csv					#filename#=$result_file$

$target_data$=get						postman					find_result					#file#=$list_data$,#testcase#=GET_hems_posts_{id}_audiences

$result$=get							postman					api_result					#api_result#=$target_data$

verify									postman					status_code					#api_result#=$result$,#expected_result#=200

$response_body$=get						api_verification		api_response				#api_result#=$result$

$expected_body$=get						api_verification		expected_result				#environment#=$test_environment$,#expected_result#=IoE\GET_hems_posts_{id}_audiences.json

verify									api_verification		dict_keys					#expected_result#=$expected_body$,#actual_result#=$response_body$


### =====
### GET data
### =====
## Get emails
$post_audiences_email$=get									file_operate			dict_list_value									#key#=emails,#response_body#=$response_body$


### =====
###	Verify
### =====
## Verify email
verify														api_verification		email											#actual_result#=$post_audiences_email$					
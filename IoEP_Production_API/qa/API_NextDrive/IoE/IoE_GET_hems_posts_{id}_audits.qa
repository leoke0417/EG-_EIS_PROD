### Verify
### ==================================
## Verify title
verify														api_verification		string											#actual_result#=$post_title$

## Verify format
verify														api_verification		int												#actual_result#=$post_format$

## Verify audienceType
verify														api_verification		string											#actual_result#=$post_audienceType$

## Verify reachCount
verify														api_verification		string											#actual_result#=$post_reachCount$

## Verify moreClickedCounts
verify														api_verification		int												#actual_result#=$post_moreClickedCounts$

## Verify linkClickedCounts > label
verify														api_verification		string											#actual_result#=$post_linkClickedCounts_label$

## Verify linkClickedCounts > url
verify														api_verification		url												#actual_result#=$post_linkClickedCounts_url$

## Verify linkClickedCounts > counts
verify														api_verification		int												#actual_result#=$post_linkClickedCounts_counts$

## Verify audits > title
verify														api_verification		string											#actual_result#=$post_audits_title$


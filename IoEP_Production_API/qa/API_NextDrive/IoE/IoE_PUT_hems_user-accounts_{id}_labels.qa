ini								api_ioe.ini
start

$cmd$=get						postman				command								#collection#=c_QA_IoE_PUT_hems_user-account_{id}_labels.json,#environment#=e_IoE.json,#iterations#=1

exec							postman				command								#command#=$cmd$

$result_file$=get				postman				result

$list_data$=get					postman				read_csv							#filename#=$result_file$

$target_data$=get				postman				find_result							#file#=$list_data$,#testcase#=PUT_hems_user-accounts_{id}_labels

$result$=get					postman				api_result							#api_result#=$target_data$

verify							postman				status_code							#api_result#=$result$,#expected_result#=200

$response_body$=get				api_verification	api_response						#api_result#=$result$

$expected_result$=get			api_verification	expected_result						#environment#=$test_environment$,#expected_result#=IoE/PUT_hems_user-accounts_{id}_labels.json

verify							api_verification	dict_keys							#expected_result#=$expected_result$,#actual_result#=$response_body$

$userLabels$=get				file_operate		dict_list_value						#key#=userLabels,#response_body#=$response_body$

verify							api_verification	string								#actual_result#=$userLabels$,#response_body#=$response_body$
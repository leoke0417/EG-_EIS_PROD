ini										api_ioe.ini

start

$cmdd$=get								postman					command								#collection#="c_QA_IoE_GET_hems_user-accounts_{id}.json",#environment#=e_IoE.json

exec									postman					command								#command#=$cmdd$

$result_file$=get						postman					result

$list_data$=get							postman					read_csv							#filename#=$result_file$

$target_data$=get						postman					find_result							#file#=$list_data$,#testcase#=GET_hems_user-accounts_{id}

$result$=get							postman					api_result							#api_result#=$target_data$

verify									postman					status_code							#api_result#=$result$,#expected_result#=200


$response_body$=get						api_verification		api_response						#api_result#=$result$

$expected_result$=get					api_verification		expected_result						#environment#=$test_environment$,#expected_result#=IoE\GET_hems_user-accounts_{id}.json

verify									api_verification		dict_keys							#expected_result#=$expected_result$,#actual_result#=$response_body$

$id$=get								file_operate			dict_list_dict_value				#first_key#=gateways,#second_key#=id,#response_body#=$response_body$

$model$=get								file_operate			dict_list_dict_value				#first_key#=gateways,#second_key#=model,#response_body#=$response_body$

$pid$=get								file_operate			dict_list_dict_value				#first_key#=gateways,#second_key#=pid,#response_body#=$response_body$

$onlineStatus$=get						file_operate			dict_list_dict_value				#first_key#=gateways,#second_key#=onlineStatus,#response_body#=$response_body$

$ip$=get								file_operate			dict_list_dict_value				#first_key#=gateways,#second_key#=ip,#response_body#=$response_body$

$firmware$=get							file_operate			dict_list_dict_value				#first_key#=gateways,#second_key#=firmware,#response_body#=$response_body$

$location$=get							file_operate			dict_list_dict_value				#first_key#=gateways,#second_key#=location,#response_body#=$response_body$

$tags$=get								file_operate			dict_list_dict_value				#first_key#=gateways,#second_key#=tags,#response_body#=$response_body$

$devices$=get							file_operate			dict_list_dict_value				#first_key#=gateways,#second_key#=devices,#response_body#=$response_body$


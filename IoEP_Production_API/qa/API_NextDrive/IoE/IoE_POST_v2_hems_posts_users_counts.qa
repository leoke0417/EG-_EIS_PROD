ini								api_ioe.ini
start

$cmd$=get						postman				command								#collection#=c_QA_IoE_POST_v2_hems_posts_users_counts.json,#environment#=e_IoE.json,#iterations#=1

exec							postman				command								#command#=$cmd$

$result_file$=get				postman				result

$list_data$=get					postman				read_csv							#filename#=$result_file$

$target_data$=get				postman				find_result							#file#=$list_data$,#testcase#=POST_v2_hems_posts_users_counts

$result$=get					postman				api_result							#api_result#=$target_data$

verify							postman				status_code							#api_result#=$result$,#expected_result#=200

$response_body$=get				api_verification	api_response						#api_result#=$result$

$expected_result$=get			api_verification	expected_result						#environment#=$test_environment$,#expected_result#=IoE/POST_v2_hems_posts_users_counts.json

verify							api_verification	dict_keys							#expected_result#=$expected_result$,#actual_result#=$response_body$

$userCounts$=get				file_operate		dict_value							#key#=userCounts,#response_body#=$response_body$

$invalidUserEmails$=get			file_operate		dict_list_value						#key#=invalidUserEmails,#response_body#=$response_body$

verify							api_verification	int									#actual_result#=$userCounts$,#response_body#=$response_body$

verify							api_verification	email								#actual_result#=$invalidUserEmails$,#response_body#=$response_body$
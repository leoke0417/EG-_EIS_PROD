ini									api_ioe.ini
start

$cmd$=get							postman				command								#collection#=c_QA_IoE_POST_v2_hems_user-accounts.json,#environment#=e_IoE.json,#iterations#=1

exec								postman				command								#command#=$cmd$

$result_file$=get					postman				result

$list_data$=get						postman				read_csv							#filename#=$result_file$

$target_data$=get					postman				find_result							#file#=$list_data$,#testcase#=POST_v2_hems_user-accounts

$result$=get						postman				api_result							#api_result#=$target_data$

verify								postman				status_code							#api_result#=$result$,#expected_result#=200

$response_body$=get					api_verification	api_response						#api_result#=$result$

$expected_result$=get				api_verification	expected_result						#environment#=$test_environment$,#expected_result#=IoE/POST_v2_hems_user-accounts.json

verify								api_verification	dict_keys							#expected_result#=$expected_result$,#actual_result#=$response_body$

$users_id$=get						file_operate		dict_list_dict_value				#first_key#=users,#second_key#=id,#response_body#=$response_body$

$users_email$=get					file_operate		dict_list_dict_value				#first_key#=users,#second_key#=email,#response_body#=$response_body$

$users_devices_model$=get			file_operate		dict_list_dict_list_dict_value		#first_key#=users,#second_key#=devices,#third_key#=model,#response_body#=$response_body$

$users_devices_onlineStatus$=get	file_operate		dict_list_dict_list_dict_value		#first_key#=users,#second_key#=devices,#third_key#=onlineStatus,#response_body#=$response_body$

verify								api_verification	int									#actual_result#=$users_id$

verify								api_verification	email								#actual_result#=$users_email$

verify								api_verification	string								#actual_result#=$users_devices_model$

verify								api_verification	int									#actual_result#=$users_devices_onlineStatus$
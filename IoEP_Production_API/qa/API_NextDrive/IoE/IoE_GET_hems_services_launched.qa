ini										api_ioe.ini

start

$cmdd$=get								postman					command								#collection#="c_QA_IoE_GET_hems_services_launched.json",#environment#=e_IoE.json

exec									postman					command								#command#=$cmdd$

$result_file$=get						postman					result

$list_data$=get							postman					read_csv							#filename#=$result_file$

$target_data$=get						postman					find_result							#file#=$list_data$,#testcase#=GET_hems_services_launched

$result$=get							postman					api_result							#api_result#=$target_data$

verify									postman					status_code							#api_result#=$result$,#expected_result#=200


$response_body$=get						api_verification		api_response						#api_result#=$result$

$expected_result$=get					api_verification		expected_result						#environment#=$test_environment$,#expected_result#=IoE\GET_hems_services_launched.json

verify									api_verification		dict_keys							#expected_result#=$expected_result$,#actual_result#=$response_body$






$next_dic$=get							file_operate			dict_list_value						#key#=launched,#response_body#=$response_body$

$response_body_next_dic$=get			file_operate			list_dict							#response_body#=$next_dic$

$exp_next_dic$=get						file_operate			dict_list_value						#key#=launched,#response_body#=$expected_result$

$expected_result_next_dic$=get			file_operate			list_dict							#response_body#=$exp_next_dic$


verify									api_verification		dict_keys							#expected_result#=$expected_result_next_dic$,#actual_result#=$response_body_next_dic$


# end





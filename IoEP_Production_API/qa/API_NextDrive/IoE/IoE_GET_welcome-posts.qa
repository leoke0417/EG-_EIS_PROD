ini										api_ioe.ini

start

$cmdd$=get								postman					command								#collection#="c_QA_IoE_GET_welcome-posts.json",#environment#=e_IoE.json

exec									postman					command								#command#=$cmdd$

$result_file$=get						postman					result

$list_data$=get							postman					read_csv							#filename#=$result_file$

$target_data$=get						postman					find_result							#file#=$list_data$,#testcase#=GET_welcome-post

$result$=get							postman					api_result							#api_result#=$target_data$

verify									postman					status_code							#api_result#=$result$,#expected_result#=200


$response_body$=get						api_verification		api_response						#api_result#=$result$

$expected_result$=get					api_verification		expected_result						#environment#=$test_environment$,#expected_result#=IoE\GET_welcome-posts.json

verify									api_verification		dict_keys							#expected_result#=$expected_result$,#actual_result#=$response_body$


$id$=get											file_operate			dict_value							#key#=id,#response_body#=$response_body$

$type$=get											file_operate			dict_value							#key#=type,#response_body#=$response_body$


$posts_title$=get						file_operate			dict_list_dict_value						#first_key#=posts,#second_key#=title,#response_body#=$response_body$

$posts_description$=get					file_operate			dict_list_dict_value						#first_key#=posts,#second_key#=description,#response_body#=$response_body$

$posts_delayMin$=get					file_operate			dict_list_dict_value						#first_key#=posts,#second_key#=delayMin,#response_body#=$response_body$


$posts_urls_label$=get							file_operate			dict_list_dict_list_dict_value						#first_key#=posts,#second_key#=urls,#third_key#=label,#response_body#=$response_body$

$posts_urls_url$=get							file_operate			dict_list_dict_list_dict_value						#first_key#=posts,#second_key#=urls,#third_key#=url,#response_body#=$response_body$

$posts_images_previewImageUrl$=get				file_operate			dict_list_dict_list_dict_value						#first_key#=posts,#second_key#=images,#third_key#=previewImageUrl,#response_body#=$response_body$

$posts_images_originalContentUrl$=get			file_operate			dict_list_dict_list_dict_value						#first_key#=posts,#second_key#=images,#third_key#=originalContentUrl,#response_body#=$response_body$





verify									api_verification		string								#actual_result#=$id$

verify									api_verification		string								#actual_result#=$type$

verify									api_verification		string								#actual_result#=$posts_title$

verify									api_verification		string								#actual_result#=$posts_description$

verify									api_verification		int									#actual_result#=$posts_delayMin$

verify									api_verification		string								#actual_result#=$posts_urls_label$

verify									api_verification		string								#actual_result#=$posts_urls_url$

verify									api_verification		string								#actual_result#=$posts_images_previewImageUrl$

verify									api_verification		string								#actual_result#=$posts_images_originalContentUrl$



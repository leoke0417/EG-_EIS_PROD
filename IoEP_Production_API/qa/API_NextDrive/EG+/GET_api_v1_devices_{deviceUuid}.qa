ini		api_egplus.ini
start
##===== Execute postman command line ======
## Get execution path
$original_path$=get											api_verification		path

## Exchange cognito token
$cognito_token$=get											api_verification		id_token				#pool_id#=$cognito_pool_id$,#client_id#=$cognito_client_id$,#username#=$app_username$,#password#=$app_password$

## Set cognito token in environment
set															api_verification		environment_token		#environment_name#=EG+.postman_environment.json,#new_token#=$cognito_token$,#environment#=$test_environment$

## Set cognito token in collection
set															api_verification		collection_token		#collection_name#=EG+.postman_collection.json,#new_token#=$cognito_token$,#testcase_name#=Get_token,#environment#=$test_environment$

## Execute cmd of newman
exec														api_verification		cmd						#original_path#=$original_path$,#environment#=$test_environment$,#command#=newman run EG+.postman_collection.json -e EG+.postman_environment.json -r csv --reporter-csv-export

## Get file location and get the file list of result
$csv_file_name$=get											api_verification		file_list				#environment#=$test_environment$,#folder_path#=newman

sleep														1
##===== END =====




##===== Test case: Get_device _info_by_UUID =====
## Read csv and target file
$device_info_uuid_response$=get								api_verification		read_csv										#environment#=$test_environment$,#csv_filename#=$csv_file_name$,#testcase_name#=Get_device _info_by_UUID

## Get status code of result
$device_info_uuid_status_code$=get							api_verification		status_code										#api_response#=$device_info_uuid_response$

## Get response body of result
$device_info_uuid_response_body$=get						api_verification		response_body									#api_response#=$device_info_uuid_response$	

## Load expected result file
$device_info_uuid_result$=get								api_verification		expected_result									#environment#=$test_environment$,#expected_result#=EG+\EG_plus_get_device_info_by_uuid.json

## Verify status code
verify														api_verification		status_code										#api_response#=$device_info_uuid_status_code$,#expected_status_code#=200

## Verify keys of response body
verify														api_verification		dict_keys										#expected_result#=$device_info_uuid_result$,#actual_result#=$device_info_uuid_response_body$

## Get motion uuid
$device_info_uuid_uuid$=get									file_operate			dict_value										#response_body#=$device_info_uuid_response_body$,#key#=uuid

## Get motion name
$device_info_uuid_name$=get									file_operate			dict_value										#response_body#=$device_info_uuid_response_body$,#key#=name

## Get motion model
$device_info_uuid_model$=get								file_operate			dict_value										#response_body#=$device_info_uuid_response_body$,#key#=model

## Get motion online status
$device_info_uuid_status$=get								file_operate			dict_value										#response_body#=$device_info_uuid_response_body$,#key#=onlineStatus

## Get motion MAC
$device_info_uuid_mac$=get									file_operate			dict_dict_value									#response_body#=$device_info_uuid_response_body$,#first_key#=attributes,#second_key#=macAddress

## verify uuid 
verify														api_verification		value											#expected_result#=$motion_uuid$,#actual_result#=$device_info_uuid_uuid$

## verify name
#verify														api_verification		value											#expected_result#=$motion_name$,#actual_result#=$device_info_uuid_name$

## verify model
verify														api_verification		value											#expected_result#=$motion_model$,#actual_result#=$device_info_uuid_model$

## verify mac
#verify														api_verification		value											#expected_result#=$motion_mac$,#actual_result#=$device_info_uuid_mac$

## verify online_status
#verify														api_verification		online_status									#actual_result#=$device_info_uuid_status$
##===== END =====
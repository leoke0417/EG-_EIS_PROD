ini		api_egplus.ini
start
##===== Execute postman command line ======
## Get execution path
$original_path$=get										api_verification	path

## Exchange cognito token
$cognito_token$=get										api_verification		id_token				#pool_id#=$cognito_pool_id$,#client_id#=$cognito_client_id$,#username#=$app_username$,#password#=$app_password$

## Set cognito token in environment
set														api_verification		environment_token		#environment_name#=EG+.postman_environment.json,#new_token#=$cognito_token$,#environment#=$test_environment$

## Set cognito token in collection
set														api_verification		collection_token		#collection_name#=EG+.postman_collection.json,#new_token#=$cognito_token$,#testcase_name#=Get_token,#environment#=$test_environment$

## Execute cmd of newman
exec													api_verification		cmd						#original_path#=$original_path$,#environment#=$test_environment$,#command#=newman run EG+.postman_collection.json -e EG+.postman_environment.json -r csv --reporter-csv-export

## Get file location and get the file list of result
$csv_file_name$=get										api_verification		file_list				#environment#=$test_environment$,#folder_path#=newman

sleep													1
##===== END =====



##===== Test case: Get location ======
## To count amount of api executed
#$final_result$=get										api_verification		api_count

## Read csv and target file
$location_response$=get									api_verification		read_csv										#environment#=$test_environment$,#csv_filename#=$csv_file_name$,#testcase_name#=Get_location 

## Get status code of result
$location_status_code$=get								api_verification		status_code										#api_response#=$location_response$

## Get response body of result
$location_response_body$=get							api_verification		response_body									#api_response#=$location_response$	

## Load expected result file
$location_result$=get									api_verification		expected_result									#environment#=$test_environment$,#expected_result#=EG+\EG_plus_get_location.json

## Verify status code
verify													api_verification		status_code										#api_response#=$location_status_code$,#expected_status_code#=200

## Verify keys of response body
verify													api_verification		dict_keys										#expected_result#=$location_result$,#actual_result#=$location_response_body$

## Get locations > city
$location_city$=get										file_operate			dict_list_dict_value							#first_key#=locations,#second_key#=city,#response_body#=$location_response_body$

## Get locations > locationKey
$location_location_key$=get								file_operate			dict_list_dict_value							#first_key#=locations,#second_key#=locationKey,#response_body#=$location_response_body$

## Verify location > city
verify													api_verification		string											#actual_result#=$location_city$

## Verify location > locationKey
verify													api_verification		string											#actual_result#=$location_location_key$

##===== END =====

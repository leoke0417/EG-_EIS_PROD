ini		api_egplus.ini
start
##===== Execute postman command line ======
## Get execution path
$original_path$=get												api_verification		path

## Exchange cognito token
$cognito_token$=get												api_verification		id_token											#pool_id#=$cognito_pool_id$,#client_id#=$cognito_client_id$,#username#=$app_username$,#password#=$app_password$

## Set cognito token in environment
set																api_verification		environment_token									#environment_name#=EG+.postman_environment.json,#new_token#=$cognito_token$,#environment#=$test_environment$

## Set cognito token in collection
set																api_verification		collection_token									#collection_name#=EG+.postman_collection.json,#new_token#=$cognito_token$,#testcase_name#=Get_token,#environment#=$test_environment$

## Execute cmd of newman
exec															api_verification		cmd													#original_path#=$original_path$,#environment#=$test_environment$,#command#=newman run EG+.postman_collection.json -e EG+.postman_environment.json -r csv --reporter-csv-export

## Get file location and get the file list of result
$csv_file_name$=get												api_verification		file_list											#environment#=$test_environment$,#folder_path#=newman

sleep															1
##===== END =====




##===== Test case: Get device data ======
## Read csv and target file
$motion_battery_data_response$=get								api_verification			read_csv										#environment#=$test_environment$,#csv_filename#=$csv_file_name$,#testcase_name#=Get_device_data_motion_battery 

## Get status code of result
$motion_battery_data_status_code$=get							api_verification			status_code										#api_response#=$motion_battery_data_response$

## Get response body of result
$motion_battery_data_response_body$=get							api_verification			response_body									#api_response#=$motion_battery_data_response$	

## Load expected result file
$motion_battery_data_result$=get								api_verification			expected_result									#environment#=$test_environment$,#expected_result#=EG+\EG_plus_get_device_data_motion_battery.json

## Verify status code
verify															api_verification			status_code										#api_response#=$motion_battery_data_status_code$,#expected_status_code#=200

## Verify keys of response body
verify															api_verification			dict_keys										#expected_result#=$motion_battery_data_result$,#actual_result#=$motion_battery_data_response_body$

## Get gatewayUuid
$motion_battery_data_gw_uuid$=get								file_operate				dict_value										#key#=gatewayUuid,#response_body#=$motion_battery_data_response_body$

## Get deviceUuid
$motion_battery_data_device_uuid$=get							file_operate				dict_value										#key#=deviceUuid,#response_body#=$motion_battery_data_response_body$

## Get data > time
$motion_battery_data_time$=get									file_operate				dict_list_dict_value							#first_key#=data,#second_key#=time,#response_body#=$motion_battery_data_response_body$

## Get data > value
$motion_battery_data_value$=get									file_operate				dict_list_dict_value							#first_key#=data,#second_key#=value,#response_body#=$motion_battery_data_response_body$

## Verify gatewayUuid
verify															api_verification			uuid											#actual_result#=$motion_battery_data_gw_uuid$

## Verify deviceUuid
verify															api_verification			uuid											#actual_result#=$motion_battery_data_device_uuid$

## Verify data > time
verify															api_verification			unix_timestamp									#actual_result#=$motion_battery_data_time$

## Verify data > value
verify															api_verification			battery											#actual_result#=$motion_battery_data_value$


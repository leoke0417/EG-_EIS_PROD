ini		api_egplus.ini
start
##===== Execute postman command line ======
## Get execution path
$original_path$=get										api_verification		path

## Exchange cognito token
$cognito_token$=get										api_verification		id_token										#pool_id#=$cognito_pool_id$,#client_id#=$cognito_client_id$,#username#=$app_username$,#password#=$app_password$

## Set cognito token in environment
set														api_verification		environment_token								#environment_name#=EG+.postman_environment.json,#new_token#=$cognito_token$,#environment#=$test_environment$

## Set cognito token in collection
set														api_verification		collection_token								#collection_name#=EG+.postman_collection.json,#new_token#=$cognito_token$,#testcase_name#=Get_token,#environment#=$test_environment$

## Execute cmd of newman
exec													api_verification		cmd												#original_path#=$original_path$,#environment#=$test_environment$,#command#=newman run EG+.postman_collection.json -e EG+.postman_environment.json -r csv --reporter-csv-export

## Get file location and get the file list of result
$csv_file_name$=get										api_verification		file_list										#environment#=$test_environment$,#folder_path#=newman

sleep													1
##===== END =====




##===== Test case: Get notification threshold ======
## Read csv and target file
$notification_threshold_response$=get					api_verification		read_csv										#environment#=$test_environment$,#csv_filename#=$csv_file_name$,#testcase_name#=Get_notification_threshold 

## Get status code of result
$notification_threshold_status_code$=get				api_verification		status_code										#api_response#=$notification_threshold_response$

## Get response body of result
$notification_threshold_response_body$=get				api_verification		response_body									#api_response#=$notification_threshold_response$	

## Load expected result file
$notification_threshold_result$=get						api_verification		expected_result									#environment#=$test_environment$,#expected_result#=EG+\EG_plus_get_notification_threshold.json

## Verify status code
#verify													api_verification		status_code										#api_response#=$notification_threshold_status_code$,#expected_status_code#=200

## Verify keys of response body
verify													api_verification		dict_keys										#expected_result#=$notification_threshold_result$,#actual_result#=$notification_threshold_response_body$

## Get motion > sensitivity
$notification_threshold_sensitivity$=get				file_operate			dict_dict_value									#first_key#=motion,#second_key#=sensitivity,#response_body#=$notification_threshold_response_body$

## Get motion > mute
$notification_threshold_mute$=get						file_operate			dict_dict_value									#first_key#=motion,#second_key#=mute,#response_body#=$notification_threshold_response_body$

## Verify motion > sensitivity
verify													api_verification		int											#actual_result#=$notification_threshold_sensitivity$

## Verify motion > mute
verify													api_verification		boolean											#actual_result#=$notification_threshold_mute$
##===== END =====
ini										api_egplus.ini

start

$cognito_token$=get						api_verification		id_token			#pool_id#=$cognito_pool_id$,#client_id#=$cognito_client_id$,#username#=$app_username$,#password#=$app_password$

set										api_verification		environment			#environment_name#=e_EGPlus.json,#new_token#=$cognito_token$

set										api_verification		collection			#collection_name#=c_egplus_get_api_v1_gateway.json,#new_token#=$cognito_token$,#testcase_name#=Get_token


$cmdd$=get								postman					command				#collection#=c_egplus_get_api_v1_gateway.json,#environment#=e_EGPlus.json

exec									postman					command				#command#=$cmdd$

$result_file$=get						postman					result

$list_data$=get							postman					read_csv			#filename#=$result_file$

$target_data$=get						postman					find_result			#file#=$list_data$,#testcase#=GET_api_v1_gateways_devices list

$result$=get							postman					api_result			#api_result#=$target_data$

verify									postman					status_code			#api_result#=$result$,#expected_result#=200


$response_body$=get						api_verification		api_response						#api_result#=$result$

$expected_result$=get					api_verification		expected_result						#environment#=$test_environment$,#expected_result#=EG+\EG_plus_GET_api_v1_getway.json

verify									api_verification		dict_keys							#expected_result#=$expected_result$,#actual_result#=$response_body$



$gateways_uuid$=get						file_operate			dict_list_dict_value				#first_key#=gateways,#second_key#=uuid,#response_body#=$response_body$

$gateways_name$=get						file_operate			dict_list_dict_value				#first_key#=gateways,#second_key#=name,#response_body#=$response_body$

$gateways_model$=get					file_operate			dict_list_dict_value				#first_key#=gateways,#second_key#=model,#response_body#=$response_body$

$gateways_onlineStatus$=get				file_operate			dict_list_dict_value				#first_key#=gateways,#second_key#=onlineStatus,#response_body#=$response_body$

$gateways_profileId$=get				file_operate			dict_list_dict_value				#first_key#=gateways,#second_key#=profileId,#response_body#=$response_body$

$gateways_wifiSsid$=get					file_operate			dict_list_dict_value				#first_key#=gateways,#second_key#=wifiSsid,#response_body#=$response_body$




$gateways_devices_uuid$=get				file_operate			dict_list_dict_list_dict_value		#first_key#=gateways,#second_key#=devices,#third_key#=uuid,#response_body#=$response_body$

$gateways_devices_name$=get				file_operate			dict_list_dict_list_dict_value		#first_key#=gateways,#second_key#=devices,#third_key#=name,#response_body#=$response_body$

$gateways_devices_model$=get			file_operate			dict_list_dict_list_dict_value		#first_key#=gateways,#second_key#=devices,#third_key#=model,#response_body#=$response_body$

$gateways_devices_onlineStatus$=get		file_operate			dict_list_dict_list_dict_value		#first_key#=gateways,#second_key#=devices,#third_key#=onlineStatus,#response_body#=$response_body$



$gateways_devices_attributes_instanceCode$=get				file_operate			gateway_device_attributes			#first_key#=gateways,#second_key#=devices,#third_key#=instanceCode,#response_body#=$response_body$

$gateways_devices_attributes_manufacturerName$=get			file_operate			gateway_device_attributes			#first_key#=gateways,#second_key#=devices,#third_key#=manufacturerName,#response_body#=$response_body$

$gateways_devices_attributes_macAddress$=get				file_operate			gateway_device_attributes			#first_key#=gateways,#second_key#=devices,#third_key#=macAddress,#response_body#=$response_body$

$gateways_devices_attributes_skin$=get						file_operate			gateway_device_attributes			#first_key#=gateways,#second_key#=devices,#third_key#=skin,#response_body#=$response_body$	




verify									api_verification		string								#actual_result#=$gateways_uuid$

verify									api_verification		string								#actual_result#=$gateways_name$

verify									api_verification		string								#actual_result#=$gateways_model$

#verify									api_verification		online_status						#actual_result#=$gateways_onlineStatus$

verify									api_verification		string								#actual_result#=$gateways_profileId$

verify									api_verification		string								#actual_result#=$gateways_wifiSsid$



verify										api_verification		string								#actual_result#=$gateways_devices_uuid$

verify										api_verification		string								#actual_result#=$gateways_devices_name$

verify										api_verification		string								#actual_result#=$gateways_devices_model$

#verify										api_verification		online_status						#actual_result#=$gateways_devices_onlineStatus$




verify											api_verification		string								#actual_result#=$gateways_devices_attributes_instanceCode$

verify											api_verification		string								#actual_result#=$gateways_devices_attributes_manufacturerName$

verify											api_verification		string								#actual_result#=$gateways_devices_attributes_macAddress$

verify											api_verification		string									#actual_result#=$gateways_devices_attributes_skin$



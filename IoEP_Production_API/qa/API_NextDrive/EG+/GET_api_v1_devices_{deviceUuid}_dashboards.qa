ini		api_egplus.ini
start
##===== Execute postman command line ======
## Get execution path
$original_path$=get											api_verification		path

## Exchange cognito token
$cognito_token$=get											api_verification		id_token										#pool_id#=$cognito_pool_id$,#client_id#=$cognito_client_id$,#username#=$app_username$,#password#=$app_password$

## Set cognito token in environment
set															api_verification		environment_token								#environment_name#=EG+.postman_environment.json,#new_token#=$cognito_token$,#environment#=$test_environment$

## Set cognito token in collection
set															api_verification		collection_token								#collection_name#=EG+.postman_collection.json,#new_token#=$cognito_token$,#testcase_name#=Get_token,#environment#=$test_environment$

## Execute cmd of newman
exec														api_verification		cmd												#original_path#=$original_path$,#environment#=$test_environment$,#command#=newman run EG+.postman_collection.json -e EG+.postman_environment.json -r csv --reporter-csv-export

## Get file location and get the file list of result
$csv_file_name$=get											api_verification		file_list										#environment#=$test_environment$,#folder_path#=newman

sleep														1
##===== END =====




##===== Test case: Get device info by uuid for dashboard =====
## Read csv and target file
$get_device_info_by_uuid_response$=get						api_verification		read_csv										#environment#=$test_environment$,#csv_filename#=$csv_file_name$,#testcase_name#=Get_device_info_by_UUID_for_dashboard

## Get status code of result
$get_device_info_by_uuid_status_code$=get					api_verification		status_code										#api_response#=$get_device_info_by_uuid_response$

## Get response body of result
$get_device_info_by_uuid_response_body$=get					api_verification		response_body									#api_response#=$get_device_info_by_uuid_response$	

## Load expected result file
$get_device_info_by_uuid_result$=get						api_verification		expected_result									#environment#=$test_environment$,#expected_result#=EG+\EG_plus_get_device_info_by_uuid_for_dashboard.json

## Verify status code
verify														api_verification		status_code										#api_response#=$get_device_info_by_uuid_status_code$,#expected_status_code#=200

## Verify keys of response body
verify														api_verification		dict_keys										#expected_result#=$get_device_info_by_uuid_result$,#actual_result#=$get_device_info_by_uuid_response_body$

## Get  uuid
$device_info_by_uuid_uuid$=get								file_operate			dict_value										#response_body#=$get_device_info_by_uuid_response_body$,#key#=uuid

## Get  name
$device_info_by_uuid_name$=get								file_operate			dict_value										#response_body#=$get_device_info_by_uuid_response_body$,#key#=name

## Get  model
$device_info_by_uuid_model$=get								file_operate			dict_value										#response_body#=$get_device_info_by_uuid_response_body$,#key#=model

## Get motion online status
$device_info_by_uuid_status$=get							file_operate			dict_value										#response_body#=$get_device_info_by_uuid_response_body$,#key#=onlineStatus

## Get battery precentage
$device_info_by_uuid_battery$=get							file_operate			dict_dict_value									#response_body#=$get_device_info_by_uuid_response_body$,#first_key#=info,#second_key#=battery

## Get motion info
$device_info_by_uuid_motion$=get							file_operate			dict_dict_value									#response_body#=$get_device_info_by_uuid_response_body$,#first_key#=info,#second_key#=motion

## Get generatedAt 
$device_info_by_uuid_generatedAt$=get						file_operate			dict_dict_value									#response_body#=$get_device_info_by_uuid_response_body$,#first_key#=info,#second_key#=generatedAt

## Verify uuid
verify														api_verification		uuid											#actual_result#=$device_info_by_uuid_uuid$

## Verify name
verify														api_verification		value											#actual_result#=$device_info_by_uuid_name$,#expected_result#=$motion_name$

## Verify model
verify														api_verification		value											#actual_result#=$device_info_by_uuid_model$,#expected_result#=Pixi-G

## Verify status
#verify														api_verification		online_status									#actual_result#=$device_info_by_uuid_status$

## Verify battery
verify														api_verification		battery											#actual_result#=$device_info_by_uuid_battery$

## Verify motion
verify														api_verification		unix_timestamp									#actual_result#=$device_info_by_uuid_motion$

## Verify generatedAt
verify														api_verification		unix_timestamp									#actual_result#=$device_info_by_uuid_generatedAt$
##===== END =====
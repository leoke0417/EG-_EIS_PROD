ini			api_eis.ini
start

$cmd$=get									postman							command												#collection#=c_QA_EIS_GET_programs_{id}.json,#environment#=e_EIS.json,#iterations#=1

exec										postman							command												#command#=$cmd$

$result_file$=get							postman							result

$list_data$=get								postman							read_csv											#filename#=$result_file$

$target_data$=get							postman							find_result											#file#=$list_data$,#testcase#=GET_programs_{id}

$result$=get								postman							api_result											#api_result#=$target_data$

verify										postman							status_code											#api_result#=$result$,#expected_result#=200

$response_body$=get							api_verification				api_response										#api_result#=$result$

$expected_result$=get						api_verification				expected_result										#environment#=$test_environment$,#expected_result#=EIS\GET_programs_{id}.json

verify										api_verification				dict_keys											#expected_result#=$expected_result$,#actual_result#=$response_body$



## Get id
$program_id_id$=get							file_operate					dict_value											#key#=id,#response_body#=$response_body$
## Get title
$program_id_title$=get						file_operate					dict_value											#key#=title,#response_body#=$response_body$

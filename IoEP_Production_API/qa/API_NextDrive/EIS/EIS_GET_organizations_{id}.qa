ini			api_eis.ini
start
$cmd$=get									postman					command								#collection#=c_QA_EIS_GET_organizations_{id}.json,#environment#=e_EIS.json,#iterations#=1

exec										postman					command								#command#=$cmd$

$result_file$=get							postman					result

$list_data$=get								postman					read_csv							#filename#=$result_file$

$target_data$=get							postman					find_result							#file#=$list_data$,#testcase#=GET_organizations_{id}

$result$=get								postman					api_result							#api_result#=$target_data$

verify										postman					status_code							#api_result#=$result$,#expected_result#=200

$response_body$=get							api_verification		api_response						#api_result#=$result$

$expected_result$=get						api_verification		expected_result						#environment#=$test_environment$,#expected_result#=EIS\GET_organizations_{id}.json

verify										api_verification		dict_keys							#expected_result#=$expected_result$,#actual_result#=$response_body$


## Get id
$org_id_id$=get								file_operate			dict_value							#key#=id,#response_body#=$response_body$

## Get displayId
$org_id_displayId$=get						file_operate			dict_value							#key#=displayId,#response_body#=$response_body$

## Get name
$org_id_name$=get							file_operate			dict_value							#key#=name,#response_body#=$response_body$

## Get country
$org_id_country$=get						file_operate			dict_value							#key#=country,#response_body#=$response_body$

## Get industry
$org_id_industry$=get						file_operate			dict_value							#key#=industry,#response_body#=$response_body$

## Get manager > name
$org_id_manager_name$=get					file_operate			dict_dict_value						#first_key#=manager,#second_key#=name,#response_body#=$response_body$

## Get manager > email
$org_id_manager_email$=get					file_operate			dict_dict_value						#first_key#=manager,#second_key#=email,#response_body#=$response_body$

## Get clients > id
$org_id_clients_id$=get						file_operate			dict_list_dict_value				#first_key#=clients,#second_key#=id,#response_body#=$response_body$

## Get clients > displayId
$org_id_clients_displayId$=get				file_operate			dict_list_dict_value				#first_key#=clients,#second_key#=displayId,#response_body#=$response_body$

## Get clients > name
$org_id_clients_name$=get					file_operate			dict_list_dict_value				#first_key#=clients,#second_key#=name,#response_body#=$response_body$


## Verify id
verify										api_verification		uuid								#actual_result#=$org_id_id$

## Verify displayId
verify										api_verification		string								#actual_result#=$org_id_displayId$

## Verify name
verify										api_verification		string								#actual_result#=$org_id_name$

## Verify country
verify										api_verification		string								#actual_result#=$org_id_country$

## Verify industry
verify										api_verification		string								#actual_result#=$org_id_industry$

## Verify manager > name
verify										api_verification		string								#actual_result#=$org_id_manager_name$

## Verify manager > email
verify										api_verification		email								#actual_result#=$org_id_manager_email$

## Verify clients > id
verify										api_verification		string								#actual_result#=$org_id_clients_id$

## Verify clients > displayId
verify										api_verification		string								#actual_result#=$org_id_clients_displayId$

## Verify clients > name
verify										api_verification		string								#actual_result#=$org_id_clients_name$
##===== END =====

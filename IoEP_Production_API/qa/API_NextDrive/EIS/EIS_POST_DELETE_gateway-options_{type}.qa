ini			api_eis.ini

start

$cmd$=get									postman					command					#collection#=c_QA_EIS_POST_gateway-options_{type}.json,#environment#=e_EIS.json,#iterations#=1

exec										postman					command					#command#=$cmd$

$result_file$=get							postman					result

$list_data$=get								postman					read_csv				#filename#=$result_file$

$target_data$=get							postman					find_result				#file#=$list_data$,#testcase#=POST_gateway-options_{type}

$result$=get								postman					api_result				#api_result#=$target_data$

verify										postman					status_code				#api_result#=$result$,#expected_result#=201

##===== END =====

$cmd$=get									postman					command					#collection#=c_QA_EIS_DELETE_gateway-options_{type}_{name}.json,#environment#=e_EIS.json,#iterations#=1

exec										postman					command					#command#=$cmd$

$result_file$=get							postman					result

$list_data$=get								postman					read_csv				#filename#=$result_file$

$target_data$=get							postman					find_result				#file#=$list_data$,#testcase#=DELETE_gateway-options_{type}_{name}

$result$=get								postman					api_result				#api_result#=$target_data$

verify										postman					status_code				#api_result#=$result$,#expected_result#=200

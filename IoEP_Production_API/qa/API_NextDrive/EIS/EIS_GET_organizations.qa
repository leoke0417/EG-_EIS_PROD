ini			api_eis.ini
start
$cmd$=get									postman					command								#collection#=c_QA_EIS_GET_organizations.json,#environment#=e_EIS.json,#iterations#=1

exec										postman					command								#command#=$cmd$

$result_file$=get							postman					result

$list_data$=get								postman					read_csv							#filename#=$result_file$

$target_data$=get							postman					find_result							#file#=$list_data$,#testcase#=GET_organizations

$result$=get								postman					api_result							#api_result#=$target_data$

verify										postman					status_code							#api_result#=$result$,#expected_result#=200

$response_body$=get							api_verification		api_response						#api_result#=$result$

$expected_result$=get						api_verification		expected_result						#environment#=$test_environment$,#expected_result#=EIS\GET_organizations.json

verify										api_verification		dict_keys							#expected_result#=$expected_result$,#actual_result#=$response_body$

$organizations_id$=get						file_operate			dict_list_dict_value				#first_key#=organizations,#second_key#=id,#response_body#=$response_body$

$organizations_displayId$=get				file_operate			dict_list_dict_value				#first_key#=organizations,#second_key#=displayId,#response_body#=$response_body$

$organizations_name$=get					file_operate			dict_list_dict_value				#first_key#=organizations,#second_key#=name,#response_body#=$response_body$

$organizations_country$=get					file_operate			dict_list_dict_value				#first_key#=organizations,#second_key#=country,#response_body#=$response_body$

$organizations_industry$=get				file_operate			dict_list_dict_value				#first_key#=organizations,#second_key#=industry,#response_body#=$response_body$

$organizations_modifiedDt$=get				file_operate			dict_list_dict_value				#first_key#=organizations,#second_key#=modifiedDt,#response_body#=$response_body$

$organizations_manager$=get					file_operate			dict_list_dict_value				#first_key#=organizations,#second_key#=manager,#response_body#=$response_body$

$total$=get									file_operate			dict_value							#key#=total,#response_body#=$response_body$

verify										api_verification		uuid								#actual_result#=$organizations_id$

verify										api_verification		string								#actual_result#=$organizations_displayId$

verify										api_verification		string								#actual_result#=$organizations_name$

verify										api_verification		string								#actual_result#=$organizations_country$

verify										api_verification		string								#actual_result#=$organizations_industry$

verify										api_verification		time								#actual_result#=$organizations_modifiedDt$

verify										api_verification		string								#actual_result#=$organizations_manager$

verify										api_verification		int									#actual_result#=$total$
##===== END =====
ini										api_eis.ini
start

$cmd$=get								postman				command								#collection#=c_QA_EIS_PUT_organization_{id}.json,#environment#=e_EIS.json,#iterations#=1

exec									postman				command								#command#=$cmd$

$result_file$=get						postman				result

$list_data$=get							postman				read_csv							#filename#=$result_file$

$target_data$=get						postman				find_result							#file#=$list_data$,#testcase#=PUT_organizations_{id}

$result$=get							postman				api_result							#api_result#=$target_data$

verify									postman				status_code							#api_result#=$result$,#expected_result#=200



$response_body$=get						api_verification	api_response						#api_result#=$result$

$expected_result$=get					api_verification	expected_result						#environment#=$test_environment$,#expected_result#=EIS/PUT_organizations_{id}.json

verify									api_verification	dict_keys							#expected_result#=$expected_result$,#actual_result#=$response_body$




$id$=get								file_operate		dict_value							#key#=id,#response_body#=$response_body$

$displayId$=get							file_operate		dict_value							#key#=displayId,#response_body#=$response_body$

$name$=get								file_operate		dict_value							#key#=name,#response_body#=$response_body$

$country$=get							file_operate		dict_value							#key#=country,#response_body#=$response_body$

$industry$=get							file_operate		dict_value							#key#=industry,#response_body#=$response_body$

$manager_name$=get						file_operate		dict_dict_value						#first_key#=manager,#second_key#=name,#response_body#=$response_body$

$manager_email$=get						file_operate		dict_dict_value						#first_key#=manager,#second_key#=email,#response_body#=$response_body$

$clients_id$=get						file_operate		dict_list_dict_value				#first_key#=clients,#second_key#=id,#response_body#=$response_body$

$clients_displayId$=get					file_operate		dict_list_dict_value				#first_key#=clients,#second_key#=displayId,#response_body#=$response_body$

$clients_name$=get						file_operate		dict_list_dict_value				#first_key#=clients,#second_key#=name,#response_body#=$response_body$






verify									api_verification	uuid								#actual_result#=$id$

verify									api_verification	string								#actual_result#=$displayId$

verify									api_verification	string								#actual_result#=$name$

verify									api_verification	string								#actual_result#=$country$

verify									api_verification	string								#actual_result#=$industry$

verify									api_verification	string								#actual_result#=$manager_name$

verify									api_verification	email								#actual_result#=$manager_email$

verify									api_verification	string								#actual_result#=$clients_id$

verify									api_verification	string								#actual_result#=$clients_displayId$

verify									api_verification	string								#actual_result#=$clients_name$
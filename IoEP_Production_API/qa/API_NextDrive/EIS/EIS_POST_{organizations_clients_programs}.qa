## Create organization
$organization_body$=get						api_eis					create_organizations_body						#country#=JP,#industry#=Others,#account_manager#=dustin.lin@nextdrive.io	

$organization_content$=get					postman					postman_json									#json_name#=c_QA_EIS_POST_organizations.json

$organization_final_collection$=get			api_eis					create_organizations_new_body					#new_body#=$organization_body$,#collection_content#=$organization_content$

set											postman					postman_json									#json_content#=$organization_final_collection$,#json_name#=c_QA_EIS_POST_organizations.json

$organization_cmd$=get						postman					command											#collection#=c_QA_EIS_POST_organizations.json,#environment#=e_EIS.json,#iterations#=1

exec										postman					command											#command#=$organization_cmd$

$organization_result_file$=get				postman					result		

$organization_list_data$=get				postman					read_csv										#filename#=$organization_result_file$

$organization_target_data$=get				postman					find_result										#file#=$organization_list_data$,#testcase#=POST_organizations

$organization_result$=get					postman					api_result										#api_result#=$organization_target_data$

verify										postman					status_code										#api_result#=$organization_result$,#expected_result#=201



$organization_response_body$=get			api_verification		api_response									#api_result#=$organization_result$

$organization_expected_body$=get			api_verification		expected_result									#environment#=$test_environment$,#expected_result#=EIS\POST_organizations.json

verify										api_verification		dict_keys										#expected_result#=$organization_expected_body$,#actual_result#=$organization_response_body$




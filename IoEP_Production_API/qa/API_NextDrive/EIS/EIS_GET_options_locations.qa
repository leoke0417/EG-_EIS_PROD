ini			api_eis.ini
start
$cmd$=get									postman					command								#collection#=c_QA_EIS_GET_options_locations.json,#environment#=e_EIS.json,#iterations#=1

exec										postman					command								#command#=$cmd$

$result_file$=get							postman					result

$list_data$=get								postman					read_csv							#filename#=$result_file$

$target_data$=get							postman					find_result							#file#=$list_data$,#testcase#=GET_options_locations

$result$=get								postman					api_result							#api_result#=$target_data$

verify										postman					status_code							#api_result#=$result$,#expected_result#=200

$response_body$=get							api_verification		api_response						#api_result#=$result$

$expected_result$=get						api_verification		expected_result						#environment#=$test_environment$,#expected_result#=EIS\GET_options_locations.json

verify										api_verification		dict_keys							#expected_result#=$expected_result$,#actual_result#=$response_body$

## Get options > en
$location_en$=get							file_operate			dict_list_dict_value				#first_key#=options,#second_key#=en,#response_body#=$response_body$

## Get options > ja
$location_ja$=get							file_operate			dict_list_dict_value				#first_key#=options,#second_key#=ja,#response_body#=$response_body$

## Get options > tw
$location_tw$=get							file_operate			dict_list_dict_value				#first_key#=options,#second_key#=tw,#response_body#=$response_body$

## Verify options > en
verify										api_verification		string								#actual_result#=$location_en$

## Verify options > ja
verify										api_verification		string								#actual_result#=$location_ja$

## Verify options > tw
verify										api_verification		string								#actual_result#=$location_tw$
##===== END =====

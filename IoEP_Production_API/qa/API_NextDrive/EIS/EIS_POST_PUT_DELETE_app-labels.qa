$delete_expected_result$=get	api_verification	expected_result						#environment#=$test_environment$,#expected_result#=EIS/DELETE_app-labels.json

verify							api_verification	dict_keys							#expected_result#=$delete_expected_result$,#actual_result#=$delete_response_body$

$delete_affected$=get			file_operate		dict_value							#key#=affected,#response_body#=$delete_response_body$

verify							api_verification	int									#actual_result#=$delete_affected$

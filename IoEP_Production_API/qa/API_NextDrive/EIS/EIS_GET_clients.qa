ini			api_eis.ini

start

$cmd$=get									postman					command					#collection#=c_QA_EIS_GET_clients.json,#environment#=e_EIS.json,#iterations#=1

exec										postman					command					#command#=$cmd$

$result_file$=get							postman					result

$list_data$=get								postman					read_csv				#filename#=$result_file$

$target_data$=get							postman					find_result				#file#=$list_data$,#testcase#=Get_clients

$result$=get								postman					api_result				#api_result#=$target_data$

verify										postman					status_code				#api_result#=$result$,#expected_result#=200

$response_body$=get							api_verification		api_response			#api_result#=$result$

$expected_result$=get						api_verification		expected_result			#environment#=$test_environment$,#expected_result#=EIS\GET_clients.json

verify										api_verification		dict_keys				#expected_result#=$expected_result$,#actual_result#=$response_body$



$clients_id$=get							file_operate			dict_list_dict_value	#first_key#=clients,#second_key#=id,#response_body#=$response_body$

$clients_displayId$=get						file_operate			dict_list_dict_value	#first_key#=clients,#second_key#=displayId,#response_body#=$response_body$

$clients_name$=get							file_operate			dict_list_dict_value	#first_key#=clients,#second_key#=name,#response_body#=$response_body$

$clients_organizationName$=get				file_operate			dict_list_dict_value	#first_key#=clients,#second_key#=organizationName,#response_body#=$response_body$

$clients_organizationDisplayId$=get			file_operate			dict_list_dict_value	#first_key#=clients,#second_key#=organizationDisplayId,#response_body#=$response_body$

$clients_location$=get						file_operate			dict_list_dict_value	#first_key#=clients,#second_key#=location,#response_body#=$response_body$

$clients_type$=get							file_operate			dict_list_dict_value	#first_key#=clients,#second_key#=type,#response_body#=$response_body$

$clients_modifiedDt$=get					file_operate			dict_list_dict_value	#first_key#=clients,#second_key#=modifiedDt,#response_body#=$response_body$

$clients_manager$=get						file_operate			dict_list_dict_value	#first_key#=clients,#second_key#=manager,#response_body#=$response_body$

$total$=get									file_operate			dict_value				#key#=total,#response_body#=$response_body$

verify										api_verification		string					#actual_result#=$clients_id$

verify										api_verification		string					#actual_result#=$clients_displayId$

verify										api_verification		string					#actual_result#=$clients_name$

verify										api_verification		string					#actual_result#=$clients_organizationName$

verify										api_verification		string					#actual_result#=$clients_organizationDisplayId$

verify										api_verification		string					#actual_result#=$clients_location$

verify										api_verification		string					#actual_result#=$clients_type$

verify										api_verification		time					#actual_result#=$clients_modifiedDt$

verify										api_verification		string					#actual_result#=$clients_manager$

verify										api_verification		int						#actual_result#=$total$



##===== END =====
ini			api_eis.ini
start

$cmd$=get													postman					command												#collection#=c_QA_EIS_PUT_programs_{id}.json,#environment#=e_EIS.json,#iterations#=1

exec														postman					command												#command#=$cmd$

$result_file$=get											postman					result


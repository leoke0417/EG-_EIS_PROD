$delete_expected_result$=get		api_verification	expected_result						#environment#=$test_environment$,#expected_result#=EIS/DELETE_gateway-binding_batch.json

verify								api_verification	dict_keys							#expected_result#=$delete_expected_result$,#actual_result#=$delete_response_body$

$delete_programId$=get				file_operate		dict_value							#key#=programId,#response_body#=$delete_response_body$

$delete_pids$=get					file_operate		dict_list_value						#key#=pids,#response_body#=$delete_response_body$

$delete_historyLog$=get				file_operate		dict_value							#key#=historyLog,#response_body#=$delete_response_body$

$delete_count$=get					file_operate		dict_value							#key#=count,#response_body#=$delete_response_body$

verify								api_verification	uuid								#actual_result#=$delete_programId$

verify								api_verification	pid									#actual_result#=$delete_pids$

verify								api_verification	string								#actual_result#=$delete_historyLog$


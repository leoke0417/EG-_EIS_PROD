ini			api_eis.ini
start

$cmd$=get									postman					command								#collection#=c_QA_EIS_GET_accounts.json,#environment#=e_EIS.json,#iterations#=1

exec										postman					command								#command#=$cmd$

$result_file$=get							postman					result

$list_data$=get								postman					read_csv							#filename#=$result_file$

$target_data$=get							postman					find_result							#file#=$list_data$,#testcase#=GET_accounts

$result$=get								postman					api_result							#api_result#=$target_data$

verify										postman					status_code							#api_result#=$result$,#expected_result#=200

$response_body$=get							api_verification		api_response						#api_result#=$result$

$expected_result$=get						api_verification		expected_result						#environment#=$test_environment$,#expected_result#=EIS\GET_accounts.json

verify										api_verification		dict_keys							#expected_result#=$expected_result$,#actual_result#=$response_body$


## Get id
$account_id$=get							file_operate			dict_list_dict_value				#first_key#=results,#second_key#=id,#response_body#=$response_body$

## Get name
$account_name$=get							file_operate			dict_list_dict_value				#first_key#=results,#second_key#=name,#response_body#=$response_body$

## Get email
$account_email$=get							file_operate			dict_list_dict_value				#first_key#=results,#second_key#=email,#response_body#=$response_body$

## Get lastLoginAt
$account_lastLoginAt$=get					file_operate			dict_list_dict_value				#first_key#=results,#second_key#=lastLoginAt,#response_body#=$response_body$

## Get status
$account_status$=get						file_operate			dict_list_dict_value				#first_key#=results,#second_key#=status,#response_body#=$response_body$

## Get roles
$account_roles$=get							file_operate			dict_list_dict_value				#first_key#=results,#second_key#=roles,#response_body#=$response_body$

## Verify id
verify										api_verification		int									#actual_result#=$account_id$

## Verify name
verify										api_verification		string								#actual_result#=$account_name$

## Verify email
## verify										#api_verification		email								#actual_result#=$account_email$

## Verify lastLoginAt
verify										api_verification		time								#actual_result#=$account_lastLoginAt$

## Verify status
verify										api_verification		string								#actual_result#=$account_status$

## Verify roles
verify										api_verification		string								#actual_result#=$account_roles$
##===== END =====

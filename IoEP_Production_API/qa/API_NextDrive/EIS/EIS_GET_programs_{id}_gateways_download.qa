ini			api_eis.ini
start

$cmd$=get									postman					command								#collection#=c_QA_EIS_GET_programs_{id}_gateways_download.json,#environment#=e_EIS.json,#iterations#=1

exec										postman					command								#command#=$cmd$

$result_file$=get							postman					result

$list_data$=get								postman					read_csv							#filename#=$result_file$

$target_data$=get							postman					find_result							#file#=$list_data$,#testcase#=GET_programs_{id}_gateways_download

$result$=get								postman					api_result							#api_result#=$target_data$

verify										postman					status_code							#api_result#=$result$,#expected_result#=200

$response_body$=get							api_verification		api_response						#api_result#=$result$

$expected_result$=get						api_verification		expected_result						#environment#=$test_environment$,#expected_result#=EIS\GET_programs_{id}_gateways_download.json

verify										api_verification		dict_keys							#expected_result#=$expected_result$,#actual_result#=$response_body$

## Get PID
$programs_gw_download_pid$=get				file_operate			dict_list_dict_value				#first_key#=data,#second_key#=pid,#response_body#=$response_body$

## Get uuid
$programs_gw_download_uuid$=get				file_operate			dict_list_dict_value				#first_key#=data,#second_key#=uuid,#response_body#=$response_body$

## Get firmwareSku
$programs_gw_download_fw_sku$=get			file_operate			dict_list_dict_value				#first_key#=data,#second_key#=firmwareSku,#response_body#=$response_body$

## Get free
$programs_gw_download_free$=get				file_operate			dict_list_dict_value				#first_key#=data,#second_key#=free,#response_body#=$response_body$

## Get createDt
$programs_gw_download_create_time$=get		file_operate			dict_list_dict_value				#first_key#=data,#second_key#=createDt,#response_body#=$response_body$

## Get syncDt
$programs_gw_download_sync_time$=get		file_operate			dict_list_dict_value				#first_key#=data,#second_key#=syncDt,#response_body#=$response_body$

##Get fields
$programs_gw_download_fields$=get			file_operate			dict_value							#key#=fields,#response_body#=$response_body$

##Get fileName
$programs_gw_download_file_name$=get		file_operate			dict_value							#key#=fileName,#response_body#=$response_body$

## Verify PID
verify										api_verification		pid									#actual_result#=$programs_gw_download_pid$

## Verify uuid
verify										api_verification		uuid								#actual_result#=$programs_gw_download_uuid$

## Verify firmwareSku
verify										api_verification		fw_sku								#actual_result#=$programs_gw_download_fw_sku$

## Verify free
verify										api_verification		free_sample							#actual_result#=$programs_gw_download_free$

## Verify createDt
verify										api_verification		time								#actual_result#=$programs_gw_download_create_time$

## Verify syncDt
verify										api_verification		time								#actual_result#=$programs_gw_download_sync_time$

## Verify null
verify										api_verification		null								#actual_result#=$programs_gw_download_fields$

## Verify string
verify										api_verification		string								#actual_result#=$programs_gw_download_file_name$
##===== END =====


ini			api_eis.ini
start

$cmd$=get									postman					command								#collection#=c_QA_EIS_GET_programs_{id}_gatewyas_free-sample_count.json,#environment#=e_EIS.json,#iterations#=1

exec										postman					command								#command#=$cmd$

$result_file$=get							postman					result

$list_data$=get								postman					read_csv							#filename#=$result_file$

$target_data$=get							postman					find_result							#file#=$list_data$,#testcase#=GET_programs_{id}_gateways_free-sample

$result$=get								postman					api_result							#api_result#=$target_data$

verify										postman					status_code							#api_result#=$result$,#expected_result#=200

$response_body$=get							api_verification		api_response						#api_result#=$result$

$expected_result$=get						api_verification		expected_result						#environment#=$test_environment$,#expected_result#=EIS\GET_programs_{id}_gateways_free-sample.json

verify										api_verification		dict_keys							#expected_result#=$expected_result$,#actual_result#=$response_body$

## Get count
$programs_gw_free_sample_count$=get			file_operate			dict_value							#key#=count,#response_body#=$response_body$

## Verify count >> int
verify										api_verification		int									#actual_result#=$programs_gw_free_sample_count$

##===== END =====

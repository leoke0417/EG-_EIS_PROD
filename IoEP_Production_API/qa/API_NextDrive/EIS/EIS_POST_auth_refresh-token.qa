ini			api_eis.ini
start

##=====Test case: Login API =====
$cmd$=get												postman					command											#collection#=c_QA_EIS_POST_auth_login.json,#environment#=e_EIS.json,#iterations#=1
												
exec													postman					command											#command#=$cmd$
												
$result_file$=get										postman					result					
												
$list_data$=get											postman					read_csv										#filename#=$result_file$
												
$target_data$=get										postman					find_result										#file#=$list_data$,#testcase#=POST_auth_login
												
$result$=get											postman					api_result										#api_result#=$target_data$
												
verify													postman					status_code										#api_result#=$result$,#expected_result#=200
									
$get_token_response_body$=get							api_verification		api_response									#api_result#=$result$

## ===== Refresh token =====
$access_token$=get										file_operate			dict_value										#key#=$access_token$,#response_body#=$get_token_response_body$

$refresh_token$=get										file_operate			dict_value										#key#=$refresh_token$,#response_body#=$get_token_response_body$

$body$=get												api_eis					refresh_token_body								#access_token#=$access_token$,#refresh_token#=$refresh_token$

$content$=get											postman					postman_json									#json_name#=c_QA_EIS_auth_refresh-token.json

$collection_final$=get									api_eis					refresh_token_new_body							#new_body#=$body$,#collection_content#=$content$

set														postman					postman_json									#json_content#=$collection_final$,#json_name#=c_QA_EIS_auth_refresh-token.json

$cmd$=get												postman					command											#collection#=c_QA_EIS_auth_refresh-token.json,#environment#=e_EIS.json,#iterations#=1

exec													postman					command											#command#=$cmd$

$result_file$=get										postman					result		

$list_data$=get											postman					read_csv										#filename#=$result_file$

$target_data$=get										postman					find_result										#file#=$list_data$,#testcase#=POST_auth_refresh-token

$result$=get											postman					api_result										#api_result#=$target_data$

verify													postman					status_code										#api_result#=$result$,#expected_result#=201

$response_body$=get										api_verification		api_response									#api_result#=$result$

$expected_body$=get										api_verification		expected_result									#environment#=$test_environment$,#expected_result#=EIS\POST_auth_refresh-token.json

verify													api_verification		dict_keys										#expected_result#=$expected_body$,#actual_result#=$response_body$

$accessToken$=get										file_operate			dict_value										#key#=access_token,#response_body#=$response_body$

$refreshToken$=get										file_operate			dict_value										#key#=refresh_token,#response_body#=$response_body$

verify													api_verification		string											#actual_result#=$accessToken$

verify													api_verification		string											#actual_result#=$refreshToken$

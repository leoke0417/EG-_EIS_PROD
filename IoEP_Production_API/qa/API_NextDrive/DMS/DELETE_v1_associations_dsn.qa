## 解關聯 device
$dissociate_url$=get					dms_api				v1_dissociate_url					#environment#=url,#ble_dsn#=ble_dsn
$dissociate_header$=get					dms_api				v1_dissociate_header				#token#=accesstoken
$dissociate_body$=get					dms_api				v1_dissociate_body					#ble_dsn#=ble_dsn
$dissociate_response$=get				dms_api				delete								#url#=$dissociate_url$,#header#=$dissociate_header$,#body#=$dissociate_body$
$dissociate_status_code$=get			dms_api				status_code							#response#=$dissociate_response$
verify									api_verification	status_code							#api_response#=$dissociate_status_code$,#expected_status_code#=200
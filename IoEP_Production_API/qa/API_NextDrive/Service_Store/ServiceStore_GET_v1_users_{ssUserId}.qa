ini										service_store.ini
start

$cmd$=get								postman				command								#collection#=c_ServiceStore_GET_v1_user_{ssUserId}.json,#environment#=e_Service_Store.json,#iterations#=1

exec									postman				command								#command#=$cmd$

$result_file$=get						postman				result

$list_data$=get							postman				read_csv							#filename#=$result_file$

$target_data$=get						postman				find_result							#file#=$list_data$,#testcase#=GET_v1_users_{ssUserId}

$result$=get							postman				api_result							#api_result#=$target_data$

verify									postman				status_code							#api_result#=$result$,#expected_result#=200

$response_body$=get						api_verification	api_response						#api_result#=$result$

$expected_result$=get					api_verification	expected_result						#environment#=$test_environment$,#expected_result#=Service_Store/GET_v1_users_{ssUserId}.json

verify									api_verification	dict_keys							#expected_result#=$expected_result$,#actual_result#=$response_body$

$id$=get								file_operate		dict_value							#key#=id,#response_body#=$response_body$

$name$=get								file_operate		dict_value							#key#=name,#response_body#=$response_body$

$pkgName$=get							file_operate		dict_value							#key#=pkgName,#response_body#=$response_body$

$egId$=get								file_operate		dict_value							#key#=egId,#response_body#=$response_body$

verify									api_verification	uuid								#actual_result#=$id$

verify									api_verification	email								#actual_result#=$name$

verify									api_verification	string								#actual_result#=$pkgName$

verify									api_verification	int									#actual_result#=$egId$
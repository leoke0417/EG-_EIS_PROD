ini										service_store.ini
start

$cmd$=get								postman					command								#collection#=c_ServiceStore_PUT_v1_users_{ssUserId}_services_{serviceId}.json,#environment#=e_Service_Store.json,#iterations#=1

exec									postman					command								#command#=$cmd$

$result_file$=get						postman					result

$list_data$=get							postman					read_csv							#filename#=$result_file$

$target_data$=get						postman					find_result							#file#=$list_data$,#testcase#=PUT_v1_users_{ssUserId}_services_{serviceId}

$result$=get							postman					api_result							#api_result#=$target_data$

verify									postman					status_code							#api_result#=$result$,#expected_result#=200

$response_body$=get						api_verification		api_response						#api_result#=$result$

$expected_result$=get					api_verification		expected_result						#environment#=$test_environment$,#expected_result#=Service_Store/PUT_v1_users_{ssUserId}_services_{serviceId}.json

verify									api_verification		dict_keys							#expected_result#=$expected_result$,#actual_result#=$response_body$

$serviceId$=get							file_operate			dict_value							#key#=serviceId,#response_body#=$response_body$

$userId$=get							file_operate			dict_value							#key#=userId,#response_body#=$response_body$

$status$=get							file_operate			dict_value							#key#=status,#response_body#=$response_body$

verify									api_verification		uuid								#actual_result#=$serviceId$

verify									api_verification		uuid								#actual_result#=$userId$

verify									api_verification		string								#actual_result#=$status$
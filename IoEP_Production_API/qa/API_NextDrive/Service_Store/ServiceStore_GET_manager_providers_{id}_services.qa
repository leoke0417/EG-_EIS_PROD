ini										service_store.ini
start

$cmd$=get								postman				command								#collection#=c_ServiceStore_GET_manager_providers_{id}_services.json,#environment#=e_Service_Store.json,#iterations#=1

exec									postman				command								#command#=$cmd$

$result_file$=get						postman				result

$list_data$=get							postman				read_csv							#filename#=$result_file$

$target_data$=get						postman				find_result							#file#=$list_data$,#testcase#=GET_manager_providers_{id}_services

$result$=get							postman				api_result							#api_result#=$target_data$

verify									postman				status_code							#api_result#=$result$,#expected_result#=200

$response_body$=get						api_verification	api_response						#api_result#=$result$

$expected_result$=get					api_verification	expected_result						#environment#=$test_environment$,#expected_result#=Service_Store/GET_manager_providers_{id}_services.json

verify									api_verification	dict_keys							#expected_result#=$expected_result$,#actual_result#=$response_body$

$id$=get								file_operate		list_dict_value						#key#=id,#response_body#=$response_body$

$name$=get								file_operate		list_dict_value						#key#=name,#response_body#=$response_body$

$status$=get							file_operate		list_dict_value						#key#=status,#response_body#=$response_body$

$publicPolicy$=get						file_operate		list_dict_value						#key#=publicPolicy,#response_body#=$response_body$

$totalUserCount$=get					file_operate		list_dict_value						#key#=totalUserCount,#response_body#=$response_body$

$activeUserCount$=get					file_operate		list_dict_value						#key#=activeUserCount,#response_body#=$response_body$

$privacyAndTermsUrl$=get				file_operate		list_dict_value						#key#=privacyAndTermsUrl,#response_body#=$response_body$

$updatedTime$=get						file_operate		list_dict_value						#key#=updatedTime,#response_body#=$response_body$

$serviceCategory$=get					file_operate		list_dict_list_value				#key#=serviceCategory,#response_body#=$response_body$

$functionCategory$=get					file_operate		list_dict_list_value				#key#=functionCategory,#response_body#=$response_body$

verify									api_verification	uuid								#actual_result#=$id$

verify									api_verification	string								#actual_result#=$name$

verify									api_verification	string								#actual_result#=$status$

verify									api_verification	string								#actual_result#=$publicPolicy$

verify									api_verification	int									#actual_result#=$totalUserCount$

verify									api_verification	int									#actual_result#=$activeUserCount$

# verify									api_verification	url									#actual_result#=$privacyAndTermsUrl$

verify									api_verification	time								#actual_result#=$updatedTime$

verify									api_verification	string								#actual_result#=$serviceCategory$

verify									api_verification	string								#actual_result#=$functionCategory$

# end
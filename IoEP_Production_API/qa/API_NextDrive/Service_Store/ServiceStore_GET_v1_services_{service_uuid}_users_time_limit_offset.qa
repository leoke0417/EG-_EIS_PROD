ini										service_store.ini
start

$cmd$=get								postman				command								#collection#=c_Service_Store_GET_v1_services_{serviceId}_users_startUploadTime_limit_offset.json,#environment#=e_Service_Store.json,#iterations#=1

exec									postman				command								#command#=$cmd$

$result_file$=get						postman				result

$list_data$=get							postman				read_csv							#filename#=$result_file$

$target_data$=get						postman				find_result							#file#=$list_data$,#testcase#=GET_v1_services_{serviceId}_users_startUploadTime_limit_offset

$result$=get							postman				api_result							#api_result#=$target_data$

verify									postman				status_code							#api_result#=$result$,#expected_result#=200

$response_body$=get						api_verification	api_response						#api_result#=$result$

$expected_result$=get					api_verification	expected_result						#environment#=$test_environment$,#expected_result#=Service_Store/GET_v1_services_{serviceId}_users_startUploadTime_limit_offset.json

verify									api_verification	dict_keys							#expected_result#=$expected_result$,#actual_result#=$response_body$

$users$=get								file_operate		dict_value							#key#=users,#response_body#=$response_body$

$userId$=get								file_operate		dict_list_dict_value			#first_key#=users,#second_key#=userId,#response_body#=$response_body$

$status$=get								file_operate		dict_list_dict_value			#first_key#=users,#second_key#=status,#response_body#=$response_body$

$packageName$=get							file_operate		dict_list_dict_value			#first_key#=users,#second_key#=packageName,#response_body#=$response_body$

$updatedAt$=get								file_operate		dict_list_dict_value			#first_key#=users,#second_key#=updatedAt,#response_body#=$response_body$



verify									api_verification	uuid								#actual_result#=$userId$,#response_body#=$response_body$

verify									api_verification	string								#actual_result#=$status$,#response_body#=$response_body$

verify									api_verification	string								#actual_result#=$packageName$,#response_body#=$response_body$

verify									api_verification	string								#actual_result#=$updatedAt$,#response_body#=$response_body$

# end
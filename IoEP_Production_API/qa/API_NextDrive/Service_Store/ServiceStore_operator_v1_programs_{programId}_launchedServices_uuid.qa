ini										service_store.ini
start

$cmd$=get								postman				command								#collection#=c_ServiceStore_operator_v1_programs_{programId}_launchedServices_{serviceUuid}.json,#environment#=e_Service_Store.json,#iterations#=1

exec									postman				command								#command#=$cmd$

$result_file$=get						postman				result

$list_data$=get							postman				read_csv							#filename#=$result_file$

$target_data$=get						postman				find_result							#file#=$list_data$,#testcase#=GET_operator_v1_programs_{programId}_launchedServices_{serviceUuid}

$result$=get							postman				api_result							#api_result#=$target_data$

verify									postman				status_code							#api_result#=$result$,#expected_result#=200

$response_body$=get						api_verification	api_response						#api_result#=$result$

$expected_result$=get					api_verification	expected_result						#environment#=$test_environment$,#expected_result#=Service_Store/GET_operator_v1_programs_{programId}_launchedServices_{serviceUuid}.json

verify									api_verification	dict_keys							#expected_result#=$expected_result$,#actual_result#=$response_body$



$name$=get								file_operate		dict_value						#key#=name,#response_body#=$response_body$

$uuid$=get								file_operate		dict_value						#key#=uuid,#response_body#=$response_body$

$publicPolicy$=get						file_operate		dict_value						#key#=publicPolicy,#response_body#=$response_body$

$icon$=get								file_operate		dict_value						#key#=icon,#response_body#=$response_body$

$serviceProvider$=get					file_operate		dict_value						#key#=serviceProvider,#response_body#=$response_body$

$subscriberCount$=get					file_operate		dict_value						#key#=subscriberCount,#response_body#=$response_body$

$subscribeType$=get						file_operate		dict_value						#key#=subscribeType,#response_body#=$response_body$

$serviceCategory$=get					file_operate		dict_list_value					#key#=serviceCategory,#response_body#=$response_body$

$image$=get								file_operate		dict_list_value					#key#=images,#response_body#=$response_body$

$releasedTime$=get						file_operate		dict_value						#key#=releasedTime,#response_body#=$response_body$

$updatedTime$=get						file_operate		dict_value						#key#=updatedTime,#response_body#=$response_body$

$description$=get						file_operate		dict_value						#key#=description,#response_body#=$response_body$

$requiredDevice$=get					file_operate		dict_list_value					#key#=requiredDevice,#response_body#=$response_body$

$contactEmail$=get						file_operate		dict_value						#key#=contactEmail,#response_body#=$response_body$

$language$=get							file_operate		dict_value						#key#=language,#response_body#=$response_body$

$privacyAndTermsUrl$=get				file_operate		dict_value						#key#=privacyAndTermsUrl,#response_body#=$response_body$

$faqUrl$=get							file_operate		dict_value						#key#=faqUrl,#response_body#=$response_body$




verify									api_verification	string								#actual_result#=$name$,#response_body#=$response_body$

verify									api_verification	uuid								#actual_result#=$uuid$,#response_body#=$response_body$

verify									api_verification	string								#actual_result#=$publicPolicy$,#response_body#=$response_body$

verify									api_verification	url									#actual_result#=$icon$,#response_body#=$response_body$

verify									api_verification	string								#actual_result#=$serviceProvider$,#response_body#=$response_body$

verify									api_verification	int									#actual_result#=$subscriberCount$,#response_body#=$response_body$

verify									api_verification	url									#actual_result#=$image$,#response_body#=$response_body$

verify									api_verification	time								#actual_result#=$releasedTime$,#response_body#=$response_body$

verify									api_verification	time								#actual_result#=$updatedTime$,#response_body#=$response_body$

verify									api_verification	string								#actual_result#=$serviceCategory$,#response_body#=$response_body$

verify									api_verification	string								#actual_result#=$description$,#response_body#=$response_body$

verify									api_verification	string								#actual_result#=$requiredDevice$,#response_body#=$response_body$

verify									api_verification	email								#actual_result#=$contactEmail$,#response_body#=$response_body$

verify									api_verification	string								#actual_result#=$language$,#response_body#=$response_body$

verify									api_verification	url									#actual_result#=$privacyAndTermsUrl$,#response_body#=$response_body$

verify									api_verification	url									#actual_result#=$faqUrl$,#response_body#=$response_body$

#end
$apiKeys$=get							file_operate		dict_list_value						#key#=apiKeys,#response_body#=$response_body$

$scopes_scope$=get						file_operate		dict_list_dict_value				#first_key#=scopes,#second_key#=scope,#response_body#=$response_body$

$scopes_dataUUID$=get					file_operate		dict_list_dict_value				#first_key#=scopes,#second_key#=dataUUID,#response_body#=$response_body$

$scopes_config$=get						file_operate		dict_list_dict_value				#first_key#=scopes,#second_key#=config,#response_body#=$response_body$


ini										api_ioe_account.ini
start


### ------------------------------------------------------------------------
### Error 403 Result Check --- 
### ------------------------------------------------------------------------
### Execute c_ioe_account_POST-v1-users_Sign_up.json file ------------------
$cmd$=get								postman					command						#collection#=c_ioe_account_POST-v1-users_Sign_up_error_403.json,#environment#=e_IoE_Account_error_test.json,#iterations#=1
exec									postman					command						#command#=$cmd$

### Get result and check status ----------------------------------------------
$result_file$=get						postman					result		

$list_data$=get							postman					read_csv					#filename#=$result_file$

$target_data$=get						postman					find_result					#file#=$list_data$,#testcase#=POST /account/v1/users

$result$=get							postman					api_result					#api_result#=$target_data$

verify									postman					status_code					#api_result#=$result$,#expected_result#=403

$response_body$=get						api_verification		api_response				#api_result#=$result$

$expected_result$=get					api_verification		expected_result				#environment#=$test_environment$,#expected_result#=IoE_Account\POST_IoE_Account_SignIn_Error_403.json

verify									api_verification		dict_keys					#expected_result#=$expected_result$,#actual_result#=$response_body$



ini										api_ioe_account.ini
start

### Execute c_ioe_account_POST_account_v1_users_forgot_password.json file ------------------
$cmd$=get								postman					command						#collection#=c_ioe_account_POST_account_v1_users_forgot_password_error_403.json,#environment#=e_IoE_Account.json,#iterations#=1
exec									postman					command						#command#=$cmd$

### Get result and check status ----------------------------------------------
$result_file$=get						postman					result		

$list_data$=get							postman					read_csv					#filename#=$result_file$

$target_data$=get						postman					find_result					#file#=$list_data$,#testcase#=POST /account/v1/users/forgot-password

$result$=get							postman					api_result					#api_result#=$target_data$

verify									postman					status_code					#api_result#=$result$,#expected_result#=403

$response_body$=get						api_verification		api_response				#api_result#=$result$

$expected_body$=get						api_verification		expected_result				#environment#=$test_environment$,#expected_result#=IoE_Account\POST_account_v1_users_forgot_password_Error_403.json

verify									api_verification		dict_keys					#expected_result#=$expected_body$,#actual_result#=$response_body$
		

								

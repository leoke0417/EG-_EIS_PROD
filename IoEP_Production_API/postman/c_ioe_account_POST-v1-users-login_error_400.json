{
	"info": {
		"_postman_id": "a1f2562a-fccd-41b6-aa00-87337c58340d",
		"name": "POST /account/v1/users/login",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "POST /account/v1/users/login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var body = JSON.parse(responseBody); \r",
							"var content = responseBody;\r",
							"tests[\"Response Body\"+content]= body.length != 0\r",
							"pm.test('Success', function() {\r",
							"    pm.response.to.have.status(200);\r",
							"    const { data } = pm.response.json();\r",
							"    const { accessToken, refreshToken } = data;\r",
							"    pm.collectionVariables.set('Auth-JWT', accessToken)\r",
							"    pm.collectionVariables.set('Auth-JWT-REFRESH-TOKEN', refreshToken)\r",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{   \r\n  \"email\" : \"{{email}}\",\r\n  \"password\": \"{{email_password}}\",\r\n  \"appUuid\": \"{{appUuid}}\",\r\n  \"clientId\": \"{{12345678}}\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{qa_ioe_account_url}}/account/v1/users/login",
					"host": [
						"{{qa_ioe_account_url}}"
					],
					"path": [
						"account",
						"v1",
						"users",
						"login"
					]
				}
			},
			"response": []
		}
	],
	"variable": [
		{
			"key": "Auth-JWT",
			"value": ""
		},
		{
			"key": "Auth-JWT-REFRESH-TOKEN",
			"value": ""
		}
	]
}
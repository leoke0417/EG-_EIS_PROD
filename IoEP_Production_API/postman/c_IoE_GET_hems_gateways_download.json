							"const parse = require('csv-parse/lib/sync'),\r",
							"    parsedBody = parse(responseBody, {relax_column_count: true});\r",
							"    \r",
							"pm.test(\"CSVpass\", function () {\r",
							"    // Check that we have at least 2 two (header + row)\r",
							"    pm.expect(parsedBody).to.have.length.above(1);\r",
							"    \r",
							"    // Getting the index of ResHash and InvTotal \r",
							"    const head = parsedBody.shift(),\r",
							"        resHash = head.indexOf('ResHash'),\r",
							"        invTotal = head.indexOf('InvTotal');\r",
							"    \r",
							"});\r",
							""
						],

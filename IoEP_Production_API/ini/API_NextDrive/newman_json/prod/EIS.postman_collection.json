	"item": [
		{
			"name": "Login",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"pm.sendRequest({\r",
							"    url: 'https://eis-api.nextdrive.io/auth/login',\r",
							"    method:'POST',\r",
							"    header:{\r",
							"        'accept': 'application/json',\r",
							"        'Content-Type': 'application/json',\r",
							"    },\r",
							"    body: {\r",
							"        mode: 'raw',\r",
							"        raw: JSON.stringify(\r",
							"                            {\r",
							"                                \"username\": \"dustin.lin@nextdrive.io\",\r",
							"                                \"password\": \"Link4581\"\r",
							"                            }\r",
							"                            )\r",
							"    }\r",
							"}, function(err, response){\r",
							"    const jsonParse = response.json();\r",
							"    pm.environment.set(\"access_token\", jsonParse.access_token)\r",
							"}\r",
							");"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"var body = JSON.parse(responseBody); \r",
							"var content = responseBody;\r",
							"tests[\"Response Body\"+content]= body.length != 0"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"username\": \"{{prod_account}}\",\r\n    \"password\": \"{{prod_password}}\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{prod_end_point}}/auth/login",
					"host": [
						"{{prod_end_point}}"
					],
					"path": [
						"auth",
						"login"
					]
				}
			},
			"response": []
		},
